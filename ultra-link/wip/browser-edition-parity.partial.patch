+interface Viewport { name: string; width: number; height: number; mobile: boolean }
+const VIEWPORTS: Viewport[] = [
+  { name: 'mobile-390x844', width: 390, height: 844, mobile: true },
+  { name: 'desktop-1280x800', width: 1280, height: 800, mobile: false },
+];
+
+interface Check { name: string; ok: boolean; detail?: string }
+const checks: { vp: string; scenario: string; list: Check[]; error?: string; ms: number }[] = [];
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+async function press(loc: Locator, mobile: boolean): Promise<void> {
+  for (let attempt = 1; ; attempt++) {
+    try {
+      await loc.scrollIntoViewIfNeeded();
+      if (mobile) await loc.tap(); else await loc.click();
+      return;
+    } catch (e) {
+      if (attempt >= 4 || !/not attached|detached|not stable|intercept/i.test((e as Error).message)) throw e;
+      await sleep(200);
+    }
+  }
+}
