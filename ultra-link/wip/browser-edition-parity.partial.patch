+// Browser edition — connections («ربط»), chat, phone share, timed location share, block / report (V2.2).
+// Same contract and rules as src/server/routes/connections.ts + src/connections/repo.ts (docs/CONNECTIONS.md):
+// one connection per accepted match; only the two participants see it (404 otherwise); accept reveals the display
+// name only; a phone only while its owner shares it in an OPEN connection; blocks freeze every connection of the pair.
+//
+// Simulated in this edition (single human; the counterparts are synthetic personas):
+//   * a contact request to a synthetic counterpart is accepted automatically after ~3 s;
+//   * a synthetic counterpart answers chat messages with CLEARLY LABELLED automatic demo replies, and shares its
+//     obviously fake number (FAKE_PHONE) after you share yours;
+//   * live location sharing is unavailable: the published page's frame refuses geolocation (409 with an Arabic note).
+
+import {
+  S, emit, fail, intentById, isAutomated, nowIso, nextId, notify, notifyUpsert, page as offsetPage, schedule, onTimer, userById, uuid,
+  type Conn, type Contact, type MatchRec, type User,
+} from './core.ts';
+
+export const MAX_MESSAGE_CHARS = 1000;
+export const AUTO_ACCEPT_MS = 3000;
+const AUTO_REPLY_MS = 1800;
+const PHONE_RE = /^[0-9+()\-\s.]{5,30}$/;
+const REPORT_REASONS = ['spam', 'scam', 'abuse', 'inappropriate', 'fake', 'other'];
+const MSG = {
+  notOpen: 'المحادثة مغلقة، لا يمكن إرسال رسائل أو مشاركة شيء فيها.',
