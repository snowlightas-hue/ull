+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+const PAGE = path.join(ROOT, 'web-demo/dist/ultra-link.html');
+const URL_ = pathToFileURL(PAGE).href;
+const ART = path.join(ROOT, 'test/e2e/artifacts/web-demo');
+const CHROMIUM = process.env.CHROMIUM_PATH || '/opt/pw-browsers/chromium';
+mkdirSync(ART, { recursive: true });
+if (!existsSync(PAGE)) { console.error(`missing ${PAGE} — run: node web-demo/build.ts`); process.exit(2); }
