+    await scenario('8-noise', async (check) => {
+      for (const u of await pageUnimplemented()) if (!unimplemented.includes(u)) unimplemented.push(u);
+      check('no unimplemented /api/* endpoint was hit', unimplemented.length === 0, unimplemented.join(', '));
+      check('no console errors, page errors or failed requests', errors.length === 0, errors.slice(0, 5).join(' || '));
