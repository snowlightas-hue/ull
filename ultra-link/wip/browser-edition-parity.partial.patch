+      if (((x.a === user.id && x.b === otherId) || (x.a === otherId && x.b === user.id)) && x.status !== 'blocked') endConnection(x, 'blocked', user.id);
+    }
+    for (const k of S.contacts) {
+      if (k.status === 'pending' && ((k.requester === user.id && k.recipient === otherId) || (k.requester === otherId && k.recipient === user.id))) k.status = 'cancelled';
+    }
+    S.timers = S.timers.filter((t) => !(t.data.connectionId === c.id));
+    emit(otherId, 'conn_update'); emit(user.id, 'conn_update');
+    return { connection: connDetail(c, user.id) };
+  }
+  if (method === 'POST' && sub === 'unblock') {
+    const otherId = userOf(c, them);
+    const before = S.blocks.length;
+    S.blocks = S.blocks.filter((b) => !(b.blocker === user.id && b.blocked === otherId));
+    if (S.blocks.length !== before) {
+      const theyBlockMe = S.blocks.some((b) => b.blocker === otherId && b.blocked === user.id);
+      for (const x of S.connections) {
+        if (((x.a === user.id && x.b === otherId) || (x.a === otherId && x.b === user.id)) && x.status === 'blocked' && x.statusBy === user.id) {
+          if (theyBlockMe) x.statusBy = otherId; else x.status = 'closed';
+          x.updatedAt = nowIso();
+        }
+      }
+      emit(user.id, 'conn_update');
+    }
+    return { connection: connDetail(c, user.id) };
+  }
+  if (method === 'POST' && sub === 'report') {
+    if (!REPORT_REASONS.includes(body.reason)) fail(400, 'bad_request', 'سبب غير صالح');
+    const note = typeof body.note === 'string' && body.note.trim() ? body.note.trim().slice(0, 500) : null;
+    const prev = S.reports.find((r) => r.connectionId === c.id && r.reporter === user.id);
+    if (prev) Object.assign(prev, { reason: body.reason, note, createdAt: nowIso() });
+    else S.reports.push({ connectionId: c.id, reporter: user.id, reported: userOf(c, them), reason: body.reason, note, createdAt: nowIso() });
+    return { ok: true, noteAr: 'وصلنا بلاغك (محفوظ في هذا المتصفح فقط — نسخة تجريبية). لا يُعاقَب أحد تلقائيًا.' };
+  }
+  return fail(404, 'not_found', 'المسار غير موجود في النسخة التجريبية');
+}
+
+function endConnection(c: Conn, status: 'closed' | 'blocked', by: string): void {
+  const t = nowIso();
+  c.status = status; c.statusBy = by; c.closedAt ??= t; c.updatedAt = t; c.aPhone = false; c.bPhone = false;
+  for (const s of c.shares) if (!s.endedAt) { s.endedAt = t; s.lat = s.lng = s.accuracyM = null; s.positionAt = null; }
+}
