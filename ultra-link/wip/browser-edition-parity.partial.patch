+for (const [vp, n] of Object.entries(noise)) console.log(` ${vp}: unimplemented /api/* endpoints hit: ${n.unimplemented.length ? n.unimplemented.join(', ') : 'none'}; console/page errors: ${n.errors.length}`);
+console.log(`\n ${scenOk}/${scen} scenario runs passed, ${pass}/${total} checks (${((Date.now() - t0) / 1000).toFixed(1)} s). Screenshots: test/e2e/artifacts/web-demo/`);
