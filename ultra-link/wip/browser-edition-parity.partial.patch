+// Browser edition — product photos. The server walks JPEG/PNG/WebP containers and strips EXIF/GPS/XMP byte by byte
+// (src/catalog/media.ts, Node Buffers). Here the same refusals apply (type by MAGIC BYTES, 5 MB, 50 MP / 16,384 px per
+// side), and metadata is removed by RE-ENCODING the decoded pixels through a <canvas> (a canvas export carries no EXIF,
+// GPS, XMP, IPTC or comments). The result is a JPEG of at most MAX_SIDE px per side, kept in IndexedDB (not
+// localStorage, which is small) and shown through a data: URL. The edition caps the total photo storage (BUDGET_BYTES).
+
+export const PHOTO_MAX_BYTES = 5 * 1024 * 1024;
+const MAX_PIXELS = 50_000_000;
+const MAX_DIM = 16_384;
+const MAX_SIDE = 1280;
+export const BUDGET_BYTES = 25 * 1024 * 1024;
+const DB_NAME = 'ultra-link-demo-media';
+const OS = 'photos';
+
+export type Sniffed = 'jpeg' | 'png' | 'webp';
+export function sniff(b: Uint8Array): Sniffed | null {
+  if (b.length >= 3 && b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff) return 'jpeg';
+  if (b.length >= 8 && [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a].every((v, i) => b[i] === v)) return 'png';
+  if (b.length >= 12 && String.fromCharCode(...b.subarray(0, 4)) === 'RIFF' && String.fromCharCode(...b.subarray(8, 12)) === 'WEBP') return 'webp';
+  return null;
+}
+
+/** Width × height from the container headers (before any decoding), or null when not found. */
+export function headerDims(b: Uint8Array, t: Sniffed): { width: number; height: number } | null {
+  const u16 = (i: number) => (b[i]! << 8) | b[i + 1]!;
+  const u32 = (i: number) => ((b[i]! << 24) >>> 0) + (b[i + 1]! << 16) + (b[i + 2]! << 8) + b[i + 3]!;
+  if (t === 'png') return b.length >= 24 ? { width: u32(16), height: u32(20) } : null;
+  if (t === 'jpeg') {
+    let i = 2;
+    while (i + 9 < b.length) {
+      if (b[i] !== 0xff) { i++; continue; }
+      const marker = b[i + 1]!;
+      if (marker === 0xd8 || marker === 0x01 || (marker >= 0xd0 && marker <= 0xd7)) { i += 2; continue; }
+      const len = u16(i + 2);
+      if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) return { height: u16(i + 5), width: u16(i + 7) };
+      i += 2 + len;
+    }
+    return null;
+  }
+  // WebP: VP8X canvas (24-bit), VP8L (14-bit), VP8 (14-bit)
+  const chunk = String.fromCharCode(...b.subarray(12, 16));
+  const le24 = (i: number) => b[i]! | (b[i + 1]! << 8) | (b[i + 2]! << 16);
+  if (chunk === 'VP8X' && b.length >= 30) return { width: le24(24) + 1, height: le24(27) + 1 };
+  if (chunk === 'VP8L' && b.length >= 25) { const v = b[21]! | (b[22]! << 8) | (b[23]! << 16) | (b[24]! << 24); return { width: (v & 0x3fff) + 1, height: ((v >> 14) & 0x3fff) + 1 }; }
+  if (chunk === 'VP8 ' && b.length >= 30) return { width: (b[26]! | (b[27]! << 8)) & 0x3fff, height: (b[28]! | (b[29]! << 8)) & 0x3fff };
+  return null;
+}
+
+export class MediaRefusal extends Error {
+  status: number; code: string;
+  constructor(status: number, code: string, msg: string) { super(msg); this.status = status; this.code = code; }
+}
+
+export interface CleanPhoto { blob: Blob; width: number; height: number; mime: 'image/jpeg' }
+
+/** Validate and re-encode an uploaded image. Throws MediaRefusal with the server's status codes. */
+export async function cleanPhoto(input: Blob): Promise<{ photo: CleanPhoto; bytes: Uint8Array }> {
+  if (!input.size) throw new MediaRefusal(400, 'empty_upload', 'لم يصل أي ملف');
+  if (input.size > PHOTO_MAX_BYTES) throw new MediaRefusal(413, 'too_large', 'الصورة أكبر من ٥ ميغابايت');
+  const bytes = new Uint8Array(await input.arrayBuffer());
+  const type = sniff(bytes);
+  if (!type) throw new MediaRefusal(415, 'unsupported_type', 'الملف ليس صورة JPEG أو PNG أو WebP');
