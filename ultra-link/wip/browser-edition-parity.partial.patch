+  if (!dims || !dims.width || !dims.height) throw new MediaRefusal(422, 'bad_image', 'الصورة تالفة أو غير مكتملة');
+  if (dims.width > MAX_DIM || dims.height > MAX_DIM || dims.width * dims.height > MAX_PIXELS) throw new MediaRefusal(422, 'too_many_pixels', 'أبعاد الصورة كبيرة جدًا (الحد ٥٠ ميغابكسل)');
