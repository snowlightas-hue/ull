+      const left = await page.evaluate(() => new Promise<number>((resolve) => {
+        const r = indexedDB.open('ultra-link-demo-media');
+        r.onsuccess = () => { const c = r.result.transaction('photos').objectStore('photos').count(); c.onsuccess = () => resolve(c.result); c.onerror = () => resolve(-1); };
+        r.onerror = () => resolve(-1);
