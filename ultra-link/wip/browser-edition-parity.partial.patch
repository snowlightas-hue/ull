+export const MISSING_AR: Record<string, string> = { price: 'السعر', 'price.currency': 'عملة السعر', 'price.unit': 'وحدة السعر (شهري/سنوي…)', place: 'المكان', when: 'الموعد', distance: 'المسافة', live: 'الموقع المباشر' };
