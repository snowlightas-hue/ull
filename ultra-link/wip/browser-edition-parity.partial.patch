--- /dev/null
+++ b/ultra-link/web-demo/account.ts
@@ -0,0 +1,95 @@
+// Browser edition — local accounts and account recovery (V2.2, docs/CONNECTIONS.md §5).
+// An account created here is the person's own, local to this browser. It stays in the synthetic realm (so it can match
+// the synthetic demo data — real and synthetic never mix), and gets a recovery code exactly like a real account on the
+// server: 16 Crockford base32 characters (80 random bits), shown once; only a hash is kept (SHA-256 here, since there
+// is no server-side pepper in a browser). Logout → «ارجع إلى حسابي» with the code works locally.
+
+import { S, fail, nextId, nowIso, publicUser, sha256Hex, userById, uuid, type User } from './core.ts';
+
+const ALPHABET = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
+const PHONE_FORM = /^[0-9+()\-\s.]*$/;
+const PHONE_RE = /^[0-9+()\-\s.]{5,30}$/;
+const RECOVER_PER_MIN = 5;
+const attempts: number[] = [];
+
+function generateCode(): string {
+  const b = crypto.getRandomValues(new Uint8Array(16));
+  let s = '';
+  for (const v of b) s += ALPHABET[v & 31];
+  return s.match(/.{4}/g)!.join('-');
+}
+/** Same normalisation as src/connections/recovery.ts (Arabic-Indic digits, case, separators, O→0, I/L→1). */
+export function normalizeCode(input: unknown): string | null {
+  if (typeof input !== 'string' || input.length > 64) return null;
+  const s = input
+    .replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 0x0660))
+    .replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 0x06f0))
+    .toUpperCase().replace(/[\s\-_.‐-―−]/g, '').replace(/O/g, '0').replace(/[IL]/g, '1');
+  if (s.length !== 16 || [...s].some((ch) => !ALPHABET.includes(ch))) return null;
+  return s;
+}
+const hashCode = (norm: string) => sha256Hex(`ul-recovery-v1:${norm}`);
+const sameName = (a: string, b: string) => {
+  const n = (x: string) => x.normalize('NFKC').replace(/[ـً-ٰٟ]/g, '').replace(/\s+/g, ' ').trim().toLowerCase();
+  return n(a) === n(b);
+};
+
+async function issue(userId: string): Promise<{ code: string; createdAt: string }> {
+  const code = generateCode();
+  const hash = await hashCode(normalizeCode(code)!);
+  const createdAt = nowIso();
+  S.recovery = S.recovery.filter((r) => r.userId !== userId);
+  S.recovery.push({ userId, hash, createdAt, lastUsedAt: null });
+  return { code, createdAt };
+}
+
+export async function accountRoutes(method: string, p: string, body: any): Promise<unknown> {
+  if (method === 'POST' && p === '/api/auth/register') {
+    const name = typeof body.displayName === 'string' ? body.displayName.trim() : '';
+    if (!name || name.length > 80) fail(400, 'bad_request', 'اكتب اسمك (حتى ٨٠ حرفًا).');
+    const phone = typeof body.phone === 'string' ? body.phone.trim() : '';
+    if (phone.length > 30 || !PHONE_FORM.test(phone)) fail(400, 'bad_request', 'رقم الهاتف غير صالح.');
+    const user: User = { id: nextId(), publicId: uuid(), displayName: name, realm: 'synthetic', handle: null, persona: null, phone: phone || null, local: true };
+    S.users.push(user);
+    const r = await issue(user.id);
+    S.session = user.id;
+    return { user: publicUser(user), recoveryCode: r.code };
+  }
+  if (method === 'POST' && p === '/api/auth/recover') {
+    const t = Date.now();
+    while (attempts.length && t - attempts[0]! > 60_000) attempts.shift();
+    if (attempts.length >= RECOVER_PER_MIN) fail(429, 'rate_limited', 'محاولات كثيرة. انتظر دقيقة ثم حاول مجددًا.');
+    attempts.push(t);
+    const norm = normalizeCode(body.code);
+    const hash = await hashCode(norm ?? 'invalid-code-0000');
+    const rec = norm ? S.recovery.find((r) => r.hash === hash) : undefined;
+    const user = rec ? userById(rec.userId) : undefined;
+    const name = typeof body.displayName === 'string' ? body.displayName.trim() : '';
+    if (!rec || !user || !user.local || (name && !sameName(name, user.displayName))) fail(401, 'bad_recovery_code', 'رمز الاسترداد غير صحيح. تأكد منه وحاول مرة ثانية.');
+    rec!.lastUsedAt = nowIso();
+    S.session = user!.id;
+    return { user: publicUser(user!) };
+  }
+  return null;
+}
+
+/** Routes that need a session: /api/account* */
+export async function accountSessionRoutes(method: string, p: string, body: any, user: User): Promise<unknown> {
+  if (method === 'GET' && p === '/api/account') {
+    const r = S.recovery.find((x) => x.userId === user.id);
+    return { user: publicUser(user), recovery: user.local ? { hasCode: !!r, createdAt: r?.createdAt ?? null, lastUsedAt: r?.lastUsedAt ?? null } : null, phone: user.phone };
+  }
+  if (method === 'POST' && p === '/api/account/recovery-code') {
+    if (!user.local) fail(403, 'real_only', 'رمز الاسترداد للحسابات التي تُنشئها بنفسك. الشخصيات التجريبية تدخل من شاشة البداية.');
+    const r = await issue(user.id);
+    return { recoveryCode: r.code, createdAt: r.createdAt };
+  }
+  if (method === 'POST' && p === '/api/account/phone') {
+    const ph = body.phone === null ? null : typeof body.phone === 'string' ? body.phone.trim() : undefined;
+    if (ph === undefined) fail(400, 'bad_request', 'طلب غير صالح');
+    if (ph && (!PHONE_RE.test(ph) || (ph.match(/\d/g) ?? []).length < 5)) fail(400, 'bad_phone', 'رقم الهاتف غير صالح.');
+    user.phone = ph || null;
+    return { phone: user.phone };
+  }
+  return null;
+}
