+  try {
+    bmp = await createImageBitmap(new Blob([bytes], { type: `image/${type}` }), { imageOrientation: 'from-image' });
+  } catch { throw new MediaRefusal(422, 'bad_image', 'الصورة تالفة أو غير مكتملة'); }
+  try {
+    let side = MAX_SIDE;
+    for (let attempt = 0; attempt < 3; attempt++) {
+      const k = Math.min(1, side / Math.max(bmp.width, bmp.height));
+      const w = Math.max(1, Math.round(bmp.width * k)), h = Math.max(1, Math.round(bmp.height * k));
+      const canvas = document.createElement('canvas');
+      canvas.width = w; canvas.height = h;
+      const ctx = canvas.getContext('2d');
+      if (!ctx) throw new MediaRefusal(422, 'bad_image', 'تعذّرت معالجة الصورة في هذا المتصفح');
+      ctx.fillStyle = '#ffffff'; // JPEG has no transparency
+      ctx.fillRect(0, 0, w, h);
+      ctx.drawImage(bmp, 0, 0, w, h);
+      const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, 'image/jpeg', attempt ? 0.72 : 0.84));
+      if (!blob) throw new MediaRefusal(422, 'bad_image', 'تعذّرت معالجة الصورة في هذا المتصفح');
+      if (blob.size <= 700 * 1024 || attempt === 2) return { photo: { blob, width: w, height: h, mime: 'image/jpeg' }, bytes };
