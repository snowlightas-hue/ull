+
+/** Keep a photo: IndexedDB when available ('idb'), else only for this page's lifetime ('memory'). */
+export async function putPhoto(id: string, blob: Blob): Promise<'idb' | 'memory'> {
+  urls.set(id, await toDataUrl(blob));
+  const ok = await tx('readwrite', (os) => os.put(blob, id));
+  return ok === null ? 'memory' : 'idb';
+}
+export async function deletePhotoBlob(id: string): Promise<void> {
+  urls.delete(id);
+  await tx('readwrite', (os) => os.delete(id));
+}
+export const photoUrl = (id: string): string | null => urls.get(id) ?? null;
+export async function photoBlob(id: string): Promise<Blob | null> {
+  const b = await tx<Blob>('readonly', (os) => os.get(id) as IDBRequest<Blob>);
+  if (b) return b;
+  const u = urls.get(id);
+  return u ? (await fetch(u)).blob() : null;
+}
+/** Load the stored photos (ids) into display URLs; returns the ids that could not be found. */
+export async function loadPhotos(ids: string[]): Promise<string[]> {
+  const missing: string[] = [];
+  for (const id of ids) {
+    if (urls.has(id)) continue;
+    const b = await tx<Blob>('readonly', (os) => os.get(id) as IDBRequest<Blob>);
+    if (b) urls.set(id, await toDataUrl(b)); else missing.push(id);
+  }
+  return missing;
+}
+export async function clearPhotos(): Promise<void> {
+  urls.clear();
+  await tx('readwrite', (os) => os.clear());
+}
