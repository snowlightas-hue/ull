+  liveUnavailable: 'مشاركة الموقع المباشر غير متاحة في نسخة المتصفح: الصفحة المنشورة لا تسمح بتحديد الموقع (GPS). جرّبها في التطبيق الكامل.',
+};
+/** Automatic replies of the synthetic personas — every one says it is automatic and synthetic. */
+const AUTO_REPLIES = [
+  '(رد تلقائي تجريبي) أهلًا! هذا رد تجريبي من شخصية اصطناعية — لا يوجد شخص حقيقي يقرأ هذه المحادثة.',
+  '(رد تلقائي تجريبي) وصلتني رسالتك. في التطبيق الحقيقي يرد عليك صاحب العرض بنفسه.',
+  '(رد تلقائي تجريبي) هذه محادثة تجريبية داخل نسخة المتصفح؛ الردود آلية ومحددة مسبقًا.',
+];
+
+// ───────────── helpers ─────────────
+type Side = 'a' | 'b';
+const sideOf = (c: Conn, userId: string): Side | null => (c.a === userId ? 'a' : c.b === userId ? 'b' : null);
+const other = (s: Side): Side => (s === 'a' ? 'b' : 'a');
+const userOf = (c: Conn, s: Side) => (s === 'a' ? c.a : c.b);
+const readOf = (c: Conn, s: Side) => (s === 'a' ? c.aRead : c.bRead);
+const phoneOn = (c: Conn, s: Side) => (s === 'a' ? c.aPhone : c.bPhone);
+const matchOf = (c: Conn) => S.matches.find((m) => m.id === c.matchId);
+const matchPublic = (c: Conn) => matchOf(c)?.publicId ?? null;
+
+function viewStatus(c: Conn, userId: string): Conn['status'] {
+  if (c.status === 'blocked' && c.statusBy !== userId) return 'closed';
+  return c.status;
+}
+const blockedBetween = (u1: string, u2: string) => S.blocks.some((b) => (b.blocker === u1 && b.blocked === u2) || (b.blocker === u2 && b.blocked === u1));
+
+function mustLoad(publicId: string, userId: string): { c: Conn; me: Side } {
+  const c = S.connections.find((x) => x.publicId === publicId && (x.a === userId || x.b === userId));
+  if (!c) fail(404, 'not_found', 'غير موجود');
+  return { c: c!, me: sideOf(c!, userId)! };
+}
+function unreadAr(n: number): string {
+  if (n <= 1) return 'رسالة جديدة واحدة';
+  if (n === 2) return 'رسالتان جديدتان';
+  if (n <= 10) return `${n} رسائل جديدة`;
+  return `${n} رسالة جديدة`;
+}
+export function cleanMessageText(raw: string): string {
+  // eslint-disable-next-line no-control-regex
+  return raw.replace(/\r\n?/g, '\n').replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/g, '').trim();
+}
+
+// ───────────── views ─────────────
+type LocationOut = { active: boolean; startedAt: string | null; expiresAt: string | null; position?: { lat: number; lng: number; accuracyM: number | null; at: string } | null };
+function locationsOf(c: Conn, userId: string): { mine: LocationOut; theirs: LocationOut } {
+  const open = c.status === 'open';
+  const t = Date.now();
+  const out = (s: Conn['shares'][number] | undefined, withPosition: boolean): LocationOut => {
+    const active = !!s && !s.endedAt && Date.parse(s.expiresAt) > t && open;
+    const o: LocationOut = { active, startedAt: active ? s!.startedAt : null, expiresAt: active ? s!.expiresAt : null };
+    if (withPosition) o.position = active && s!.lat !== null ? { lat: s!.lat!, lng: s!.lng!, accuracyM: s!.accuracyM, at: s!.positionAt! } : null;
+    return o;
+  };
+  return { mine: out(c.shares.find((s) => s.userId === userId), false), theirs: out(c.shares.find((s) => s.userId !== userId), true) };
+}
+
+function connCard(c: Conn, userId: string) {
+  const me = sideOf(c, userId)!;
+  const them = other(me);
+  const otherUser = userById(userOf(c, them));
+  const mineIntent = intentById(me === 'a' ? c.aIntent : c.bIntent);
+  const otherIntent = intentById(me === 'a' ? c.bIntent : c.aIntent);
+  const phone = c.status === 'open' && phoneOn(c, them) ? otherUser?.phone ?? null : null;
+  return {
+    id: c.publicId, status: viewStatus(c, userId), blockedByMe: c.status === 'blocked' && c.statusBy === userId,
+    synthetic: (otherUser?.realm ?? 'synthetic') === 'synthetic', matchId: matchPublic(c),
+    counterpart: { displayName: otherUser?.displayName ?? 'الطرف الآخر', ...(phone ? { phone } : {}) },
+    titles: { mineAr: mineIntent?.title_ar ?? null, otherAr: otherIntent?.title_ar ?? null },
+    unread: Math.max(0, c.messages.length - readOf(c, me)), messageCount: c.messages.length,
+    lastMessageAt: c.lastMessageAt, createdAt: c.createdAt, updatedAt: c.updatedAt,
+  };
+}
+
+function connDetail(c: Conn, userId: string) {
+  const me = sideOf(c, userId)!;
+  const them = other(me);
+  const loc = locationsOf(c, userId);
+  const u = userById(userId);
+  return {
+    ...connCard(c, userId),
+    canSend: c.status === 'open',
+    reportedByMe: S.reports.some((r) => r.connectionId === c.id && r.reporter === userId),
+    me: { phoneShared: phoneOn(c, me), hasPhone: !!u?.phone, lastReadSeq: readOf(c, me), location: loc.mine },
+    them: { phoneShared: c.status === 'open' && phoneOn(c, them), lastReadSeq: readOf(c, them), location: loc.theirs },
+  };
+}
+
+const msgOut = (m: Conn['messages'][number], userId: string) => {
+  const mine = m.sender === userId;
+  return { seq: m.seq, mine, text: m.text, createdAt: m.createdAt, ...(mine ? { clientMsgId: m.clientMsgId } : {}) };
+};
+
+// ───────────── contact flow hooks (used by the core match routes) ─────────────
+/** null = may send a contact request on this match; else the refusal (same codes as the server). */
+export function contactRefusal(m: MatchRec, meId: string, otherId: string): void {
+  const a = userById(meId), b = userById(otherId);
+  if (!a || !b || a.realm !== b.realm) fail(409, 'realm_mismatch', MSG.realm);
+  if (blockedBetween(meId, otherId)) fail(409, 'contact_unavailable', MSG.unavailable);
+  const c = S.connections.find((x) => x.matchId === m.id);
+  if (c && c.status !== 'open') fail(409, 'connection_ended', MSG.ended);
+}
+
+/** Open (idempotently) the connection of an accepted contact request's match. */
+export function openConnectionForMatch(m: MatchRec): Conn {
+  const existing = S.connections.find((x) => x.matchId === m.id);
+  if (existing) return existing;
+  const ua = userById(m.aUser), ub = userById(m.bUser);
+  if (!ua || !ub || ua.realm !== ub.realm) fail(409, 'realm_mismatch', MSG.realm);
+  if (blockedBetween(m.aUser, m.bUser)) fail(409, 'contact_unavailable', MSG.unavailable);
+  const t = nowIso();
+  const c: Conn = {
+    id: nextId(), publicId: uuid(), matchId: m.id, a: m.aUser, b: m.bUser, aIntent: m.a, bIntent: m.b, status: 'open', statusBy: null,
+    aPhone: false, bPhone: false, aRead: 0, bRead: 0, messages: [], shares: [], lastMessageAt: null, activityAt: t, createdAt: t, updatedAt: t, closedAt: null,
+  };
+  S.connections.push(c);
+  return c;
+}
+
+/** MatchCard privacy + connection info (src/connections/match-cards.ts): name after accept; phone only while shared. */
+export function decorateMatchCard(cardOut: { contact?: { status?: string; counterpart?: { displayName: string; phone?: string } }; connection?: unknown }, m: MatchRec, userId: string): void {
+  if (cardOut.contact?.counterpart) cardOut.contact.counterpart = { displayName: cardOut.contact.counterpart.displayName };
+  const c = S.connections.find((x) => x.matchId === m.id && (x.a === userId || x.b === userId));
+  if (!c) return;
+  const me = sideOf(c, userId)!;
+  cardOut.connection = { id: c.publicId, status: viewStatus(c, userId), unread: Math.max(0, c.messages.length - readOf(c, me)) };
+  if (c.status === 'open' && phoneOn(c, other(me)) && cardOut.contact?.counterpart) {
+    const p = userById(userOf(c, other(me)))?.phone;
+    if (p) cardOut.contact.counterpart.phone = p;
+  }
+}
+
+/** POST /api/matches/:id/contact */
+export function requestContact(user: User, m: MatchRec): { contactRequest: { id: string; status: string } } {
+  if (m.state === 'invalidated') fail(409, 'match_invalidated', 'هذه المطابقة لم تعد صالحة');
+  const otherId = m.aUser === user.id ? m.bUser : m.aUser;
+  contactRefusal(m, user.id, otherId);
+  let c = S.contacts.find((x) => x.matchId === m.id && x.requester === user.id);
+  if (!c) {
+    c = { id: uuid(), matchId: m.id, requester: user.id, recipient: otherId, status: 'pending', createdAt: nowIso() };
+    S.contacts.push(c);
+    notify(otherId, 'contact_request', 'طلب تواصل جديد', 'شخص مهتم بمطابقة معك. إذا وافقت يظهر لكما الاسم فقط وتُفتح محادثة داخل التطبيق؛ الرقم لا يظهر إلا إذا شاركه صاحبه.', { matchId: m.publicId, requestId: c.id }, `contact:${c.id}`);
+    // demo only: a synthetic counterpart accepts by itself after a few seconds (announced as automatic)
+    if (isAutomated(userById(otherId))) schedule('auto_accept', AUTO_ACCEPT_MS, { contactId: c.id });
+  }
+  emit(user.id, 'match_update');
+  return { contactRequest: { id: c.id, status: c.status } };
+}
+
+function accept(c: Contact, auto: boolean): Conn {
+  const m = S.matches.find((x) => x.id === c.matchId)!;
+  const conn = openConnectionForMatch(m);
+  c.status = 'accepted';
+  notify(c.requester, 'contact_accepted', 'تمت الموافقة على التواصل',
+    auto ? 'قبول تلقائي في نسخة المتصفح (شخصية اصطناعية). صار بإمكانكما المحادثة داخل التطبيق؛ الردود هناك آلية ومعلَّمة.' : 'صار بإمكانكما المحادثة داخل التطبيق. يظهر الاسم فقط؛ الرقم لا يظهر إلا إذا شاركه صاحبه.',
+    { matchId: m.publicId, connectionId: conn.publicId }, `contact-reply:${c.id}`);
+  emit(c.recipient, 'match_update');
+  emit(c.requester, 'match_update');
+  return conn;
+}
+
+onTimer('auto_accept', ({ contactId }) => {
+  const c = S.contacts.find((x) => x.id === contactId);
+  if (!c || c.status !== 'pending') return;
+  try { accept(c, true); } catch { c.status = 'cancelled'; }
+});
+
+/** POST /api/contact-requests/:id/respond */
+export function respondContact(user: User, requestId: string, acceptIt: boolean) {
+  const c = S.contacts.find((x) => x.id === requestId && x.recipient === user.id && x.status === 'pending');
+  if (!c) fail(404, 'not_found', 'الطلب غير موجود أو تمت الإجابة عليه');
+  let conn: Conn | null = null;
+  if (acceptIt) conn = accept(c!, false);
+  else {
+    c!.status = 'declined';
+    const m = S.matches.find((x) => x.id === c!.matchId)!;
+    notify(c!.requester, 'contact_declined', 'تم رفض طلب التواصل', null, { matchId: m.publicId }, `contact-reply:${c!.id}`);
+    emit(user.id, 'match_update');
+  }
+  return { contactRequest: { id: c!.id, status: c!.status }, ...(conn ? { connection: { id: conn.publicId, status: conn.status } } : {}) };
+}
+
+// ───────────── messages ─────────────
+function appendMessage(c: Conn, senderId: string, text: string, clientMsgId: string, auto = false) {
+  const me = sideOf(c, senderId)!;
+  const seq = c.messages.length + 1;
+  const t = nowIso();
+  const m = { seq, sender: senderId, clientMsgId, text, createdAt: t, ...(auto ? { auto: true } : {}) };
+  c.messages.push(m);
+  c.lastMessageAt = t; c.activityAt = t; c.updatedAt = t;
+  if (me === 'a') c.aRead = seq; else c.bRead = seq;
+  const them = other(me);
+  const recipient = userOf(c, them);
+  const sender = userById(senderId);
+  notifyUpsert(recipient, 'connection_message', `رسائل جديدة من ${sender?.displayName ?? 'الطرف الآخر'}`, unreadAr(seq - readOf(c, them)),
+    { connectionId: c.publicId, matchId: matchPublic(c) }, `conn-msg:${c.publicId}`);
+  // replying means I have read everything before: clear my own grouped notification for this connection
+  for (const n of S.notifications) if (n.recipient === senderId && n.dedupe === `conn-msg:${c.publicId}` && !n.readAt) n.readAt = t;
+  emit(recipient, 'conn_message');
+  emit(senderId, 'conn_message');
+  return m;
+}
+
+onTimer('auto_reply', ({ connectionId, from }) => {
+  const c = S.connections.find((x) => x.id === connectionId);
+  if (!c || c.status !== 'open' || !from || !isAutomated(userById(from))) return;
+  const n = c.messages.filter((m) => m.sender === from && m.auto).length;
+  appendMessage(c, from, AUTO_REPLIES[n % AUTO_REPLIES.length]!, uuid(), true);
+});
+
+onTimer('auto_phone', ({ connectionId, from }) => {
+  const c = S.connections.find((x) => x.id === connectionId);
+  const u = from ? userById(from) : undefined;
+  if (!c || c.status !== 'open' || !u || !isAutomated(u)) return;
+  const s = sideOf(c, u.id);
+  if (!s || phoneOn(c, s)) return;
+  if (s === 'a') c.aPhone = true; else c.bPhone = true;
+  c.updatedAt = nowIso();
+  appendMessage(c, u.id, `(رد تلقائي تجريبي) شاركتُ رقمي أيضًا — وهو رقم وهمي للتجربة فقط: ${u.phone ?? ''}`, uuid(), true);
+  emit(userOf(c, other(s)), 'conn_update');
+});
+
+// ───────────── routes ─────────────
+/** /api/connections/* (null when the path is not a connections route) */
+export function connectionRoutes(method: string, p: string, q: URLSearchParams, body: any, user: User): unknown {
+  let m: RegExpMatchArray | null;
+  if (method === 'GET' && p === '/api/connections') {
+    const st = q.get('status') || 'open';
+    if (!['open', 'closed', 'archived', 'all'].includes(st)) fail(400, 'bad_request', 'قيمة غير صالحة');
+    const statuses = st === 'closed' ? ['closed', 'blocked'] : st === 'archived' ? ['archived'] : st === 'all' ? ['open', 'closed', 'blocked', 'archived'] : ['open'];
+    const all = S.connections.filter((c) => (c.a === user.id || c.b === user.id) && statuses.includes(c.status))
+      .sort((x, y) => y.activityAt.localeCompare(x.activityAt) || Number(y.id) - Number(x.id));
+    const pg = offsetPage(all, q);
+    return { ...pg, items: pg.items.map((c) => connCard(c, user.id)) };
+  }
+  if (!(m = p.match(/^\/api\/connections\/([\w-]+)(?:\/(.+))?$/))) return null;
+  const id = m[1]!;
+  const sub = m[2] ?? '';
+  const { c, me } = mustLoad(id, user.id);
+  const them = other(me);
+  const counterpart = userById(userOf(c, them));
+
+  if (method === 'GET' && sub === '') return { connection: connDetail(c, user.id) };
+
+  if (method === 'GET' && sub === 'messages') {
+    const lastRead = { mine: readOf(c, me), theirs: readOf(c, them) };
+    const limit = Math.min(100, Math.max(1, Number(q.get('limit')) || (q.has('after') ? 100 : 30)));
+    if (q.has('after')) {
+      const after = Number(q.get('after'));
+      if (!Number.isInteger(after) || after < 0) fail(400, 'bad_request', 'قيمة غير صالحة');
+      const newer = c.messages.filter((x) => x.seq > after);
+      return { items: newer.slice(0, limit).map((x) => msgOut(x, user.id)), more: newer.length > limit, total: c.messages.length, lastReadSeq: lastRead };
+    }
+    // newest first; `next` = older, `prev` = newer (cursor = a seq)
+    const total = c.messages.length;
+    let cur: number | null = null;
+    if (q.get('cursor')) { try { cur = Number(atob(q.get('cursor')!)); } catch { cur = NaN; } if (!Number.isInteger(cur)) fail(400, 'bad_cursor', 'مؤشر الصفحة غير صالح'); }
+    const prev = q.get('dir') === 'prev' && cur !== null;
+    let rows = prev ? c.messages.filter((x) => x.seq > cur!).slice(0, limit + 1) : c.messages.filter((x) => cur === null || x.seq < cur).reverse().slice(0, limit + 1);
+    const hasMore = rows.length > limit;
+    rows = rows.slice(0, limit);
+    if (prev) rows.reverse();
+    const first = rows[0], last = rows[rows.length - 1];
+    const rangeStart = first ? total - first.seq + 1 : 0;
+    return {
+      items: rows.map((x) => msgOut(x, user.id)), total, limit,
+      nextCursor: last && (prev ? last.seq > 1 : hasMore) ? btoa(String(last.seq)) : null,
+      prevCursor: first && rangeStart > 1 ? btoa(String(first.seq)) : null,
+      rangeStart: rows.length ? rangeStart : 0, rangeEnd: rows.length ? rangeStart + rows.length - 1 : 0,
+      lastReadSeq: lastRead,
+    };
+  }
+
+  if (method === 'POST' && sub === 'messages') {
+    const text = cleanMessageText(String(body.text ?? ''));
+    const cid = String(body.clientMsgId ?? '').toLowerCase();
+    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(cid)) fail(400, 'bad_request', 'طلب غير صالح');
+    if (!text) fail(400, 'empty_message', 'اكتب رسالة أولًا.');
+    if ([...text].length > MAX_MESSAGE_CHARS) fail(400, 'message_too_long', 'الرسالة طويلة. الحد ١٠٠٠ حرف.');
+    const dup = c.messages.find((x) => x.sender === user.id && x.clientMsgId === cid);
+    if (dup) {
+      if (dup.text !== text) fail(409, 'client_msg_id_reused', 'هذا المعرّف استُخدم لرسالة أخرى.');
+      return { message: msgOut(dup, user.id), duplicate: true };
+    }
+    if (c.status !== 'open') fail(409, 'connection_not_open', MSG.notOpen);
+    const msg = appendMessage(c, user.id, text, cid);
+    if (isAutomated(counterpart)) schedule('auto_reply', AUTO_REPLY_MS, { connectionId: c.id, from: counterpart!.id });
+    return { message: msgOut(msg, user.id), duplicate: false };
+  }
+
+  if (method === 'POST' && sub === 'read') {
+    const seq = Number(body.seq);
+    if (!Number.isInteger(seq) || seq < 0) fail(400, 'bad_request', 'قيمة غير صالحة');
+    const cur = readOf(c, me);
+    const next = Math.max(cur, Math.min(seq, c.messages.length));
+    if (next > cur) { if (me === 'a') c.aRead = next; else c.bRead = next; emit(userOf(c, them), 'conn_update'); }
+    if (next >= c.messages.length) {
+      let k = 0;
+      for (const n of S.notifications) if (n.recipient === user.id && n.dedupe === `conn-msg:${c.publicId}` && !n.readAt) { n.readAt = nowIso(); k++; }
+      if (k) emit(user.id, 'counts');
+    }
+    return { ok: true, lastReadSeq: next, unread: Math.max(0, c.messages.length - next) };
+  }
+
+  if (method === 'POST' && sub === 'phone') {
+    if (typeof body.share !== 'boolean') fail(400, 'bad_request', 'طلب غير صالح');
+    if (c.status !== 'open') fail(409, 'connection_not_open', MSG.notOpen);
+    if (body.share) {
+      if (body.phone) {
+        const ph = String(body.phone).trim();
+        if (!PHONE_RE.test(ph) || (ph.match(/\d/g) ?? []).length < 5) fail(400, 'bad_phone', 'رقم الهاتف غير صالح.');
+        user.phone = ph;
+      }
+      if (!user.phone) fail(409, 'no_phone', 'أضف رقم هاتفك أولًا حتى تشاركه.');
+    }
+    if (me === 'a') c.aPhone = !!body.share; else c.bPhone = !!body.share;
+    c.updatedAt = nowIso();
+    emit(userOf(c, them), 'conn_update');
+    // demo: the synthetic counterpart answers by sharing its (fake, labelled) number too
+    if (body.share && isAutomated(counterpart) && !phoneOn(c, them)) schedule('auto_phone', AUTO_REPLY_MS, { connectionId: c.id, from: counterpart!.id });
+    return { connection: connDetail(c, user.id) };
+  }
+
+  if (method === 'POST' && sub === 'location/start') {
+    if (![15, 30, 60].includes(body.minutes)) fail(400, 'bad_request', 'مدة غير صالحة.');
+    if (c.status !== 'open') fail(409, 'connection_not_open', MSG.notOpen);
+    // the published page cannot read the device position, so a share could never send one: say so instead of pretending
+    return fail(409, 'not_available_in_browser', MSG.liveUnavailable);
+  }
+  if (method === 'POST' && sub === 'location/stop') {
+    const s = c.shares.find((x) => x.userId === user.id && !x.endedAt);
+    if (s) { s.endedAt = nowIso(); s.lat = s.lng = s.accuracyM = null; s.positionAt = null; emit(userOf(c, them), 'conn_update'); }
+    return { ok: true };
+  }
+  if (method === 'POST' && sub === 'location') {
+    const s = c.shares.find((x) => x.userId === user.id && !x.endedAt && Date.parse(x.expiresAt) > Date.now());
+    if (!s || c.status !== 'open') fail(409, 'share_not_active', 'مشاركة الموقع متوقفة. ابدأها من جديد إذا أردت.');
+    if (!Number.isFinite(body.lat) || !Number.isFinite(body.lng) || Math.abs(body.lat) > 90 || Math.abs(body.lng) > 180) fail(400, 'bad_request', 'إحداثيات غير صالحة');
+    Object.assign(s!, { lat: body.lat, lng: body.lng, accuracyM: body.accuracyM == null ? null : Math.round(body.accuracyM), positionAt: nowIso() });
+    emit(userOf(c, them), 'conn_location');
+    return { ok: true, expiresAt: s!.expiresAt };
+  }
+  if (method === 'GET' && sub === 'location') return locationsOf(c, user.id);
+
+  if (method === 'POST' && sub === 'close') {
+    if (!(c.status === 'closed' || (c.status === 'blocked' && viewStatus(c, user.id) === 'closed'))) {
+      if (c.status !== 'open') fail(409, 'invalid_transition', 'لا يمكن تنفيذ هذا الإجراء على حالتها الحالية.');
+      endConnection(c, 'closed', user.id);
+      emit(userOf(c, them), 'conn_update'); emit(user.id, 'conn_update');
+    }
+    return { connection: connDetail(c, user.id) };
+  }
+  if (method === 'POST' && sub === 'block') {
+    const otherId = userOf(c, them);
+    if (!S.blocks.some((b) => b.blocker === user.id && b.blocked === otherId)) S.blocks.push({ blocker: user.id, blocked: otherId, connectionId: c.id });
