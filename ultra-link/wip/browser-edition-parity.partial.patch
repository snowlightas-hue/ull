+
+export type Trigger = 'interactive' | 'seed' | 'job' | 'edit' | 'status';
+export function matchIntent(intentId: string, trigger: Trigger): Run {
+  refreshSimulatedDrivers();
+  const row = intentById(intentId)!;
+  const me = rowToMatchable(reg, row);
+  const run: Run = { intentId, version: row.version, candidates: 0, confirmed: 0, possible: 0, excluded: 0, exclusions: [], newMatches: 0, invalidated: 0 };
+  const agg = new Map<string, { count: number; textAr: string }>();
