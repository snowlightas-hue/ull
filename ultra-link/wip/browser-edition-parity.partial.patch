+// Browser edition — stores, catalog, bulk import and photos (V2.3). Same contract as src/server/routes/catalog.ts
+// (docs/CONTRACTS.md «Stores & catalog»): owner-only (another user's store / product / photo → 404), a product IS an
+// ordinary provide intent, so matching, cards and match APIs see it unchanged.
+// Reused as they are (pure modules): the bulk-import parser and preview (src/catalog/import.ts — the same
+// parseUtterance/applyTurn/buildSpec path as the server), the store/product views (src/catalog/repo.ts) and the
+// group label (src/catalog/match-cards.ts). Re-implemented here: the storage (in memory + localStorage) and the
+// photo intake (media.ts: canvas re-encode instead of the server's byte-level EXIF stripper).
+
+import type { IntentSpec } from '../src/domain/types.ts';
+import { validateSpec } from '../src/domain/validate.ts';
+import { intentToSpec, type IntentRow } from '../src/repo/intents.ts';
+import { amountToMinor, markDuplicates, normName, parseItem, previewLine, splitImportText, type ImportDefaults, type ItemInput, type ParsedItem } from '../src/catalog/import.ts';
+import { CATALOG_LIMITS, ITEM_STATUSES, storeLabel, toProductCard, toStoreView, type PhotoRef, type ProductCard, type StoreView } from '../src/catalog/repo.ts';
+import { groupLabelAr } from '../src/catalog/match-cards.ts';
+import { DEMO_STORE, DEMO_STORE_LINES } from 'virtual:stores-demo';
+import {
+  S, Reply, createIntent, fail, hash53, intentById, intentByPublic, matchCounts, nowIso, nextId, page as offsetPage, reg, rematch, setIntentStatus,
+  sha256Hex, updateIntentSpec, uuid, matchIntent,
+  type ItemRec, type RematchSummary, type StoreRec, type User,
+} from './core.ts';
+import { BUDGET_BYTES, cleanPhoto, deletePhotoBlob, MediaRefusal, photoBlob, photoUrl, putPhoto } from './media.ts';
+
+const productTitle = (nameAr: string, realm: 'real' | 'synthetic') => (realm === 'synthetic' ? `${nameAr} (تجريبي)` : nameAr);
+const CURRENCIES = ['USD', 'TRY', 'SYP', 'EUR'];
+const UNITS = ['total', 'month', 'year', 'week', 'day', 'hour', 'session', 'person'];
+const emptyRematch = (): RematchSummary => ({ evaluated: 0, queued: 0, newMatches: 0, invalidated: 0, confirmed: 0, possible: 0 });
+
+// ───────────── views ─────────────
+function storeCounts(storeId: string): StoreView['counts'] {
+  const c = { total: 0, active: 0, paused: 0, expired: 0, fulfilled: 0 };
+  for (const it of S.items) {
+    if (it.storeId !== storeId) continue;
+    const st = intentById(it.intentId)?.status;
+    if (st && (ITEM_STATUSES as readonly string[]).includes(st)) { c[st as keyof Omit<typeof c, 'total'>]++; c.total++; }
+  }
+  return c;
+}
+const storeView = (s: StoreRec): StoreView => toStoreView(reg, s, storeCounts(s.id));
+
+function photoRefs(intentId: string): PhotoRef[] {
+  return S.photos.filter((p) => p.intentId === intentId).sort((a, b) => a.slot - b.slot)
+    .map((p) => ({ id: p.id, url: photoUrl(p.id) ?? '', slot: p.slot, width: p.width, height: p.height, mime: p.mime, bytes: p.bytes }))
+    .filter((p) => p.url);
+}
+function productCard(s: StoreRec, it: ItemRec): ProductCard {
+  const row = intentById(it.intentId)!;
+  const r = { ...row, position: it.position, item_name: it.nameAr, paused_by_store: it.pausedByStore, store_public_id: s.public_id } as Parameters<typeof toProductCard>[1];
+  return toProductCard(reg, r, photoRefs(row.id), matchCounts(row.id));
+}
+
+// ───────────── owner-scoped lookups ─────────────
+function ownStore(user: User, publicId: string): StoreRec {
+  const s = S.stores.find((x) => x.public_id === publicId && x.owner_id === user.id);
+  if (!s) fail(404, 'not_found', 'غير موجود');
+  return s!;
+}
+function ownItem(user: User, s: StoreRec, itemPublicId: string): { it: ItemRec; row: IntentRow } {
+  const row = intentByPublic(itemPublicId);
+  const it = row ? S.items.find((x) => x.storeId === s.id && x.intentId === row.id) : undefined;
+  if (!row || !it || row.user_id !== user.id) fail(404, 'not_found', 'غير موجود');
+  return { it: it!, row: row! };
+}
+function existingNames(storeId: string): Map<string, { id: string; nameAr: string }> {
+  const out = new Map<string, { id: string; nameAr: string }>();
+  for (const it of S.items) {
+    if (it.storeId !== storeId) continue;
+    const row = intentById(it.intentId);
+    if (row && row.status !== 'closed') out.set(it.nameNorm, { id: row.public_id, nameAr: it.nameAr });
+  }
+  return out;
+}
+const liveItemCount = (storeId: string) => S.items.filter((it) => it.storeId === storeId && intentById(it.intentId)?.status !== 'closed').length;
+
+// ───────────── stores ─────────────
+function checkPlace(placeId: unknown): number {
+  const id = Number(placeId);
+  const p = reg.placeById.get(id);
+  if (!Number.isInteger(id) || !p || id === reg.rootPlaceId) fail(422, 'bad_place', 'اختر مدينة أو منطقة المتجر');
+  return id;
+}
+const optText = (v: unknown, max: number): string | null => (typeof v === 'string' && v.trim() ? v.trim().slice(0, max) : null);
+
+export function createStore(user: User, b: any): StoreRec {
+  const name = typeof b.nameAr === 'string' ? b.nameAr.trim() : '';
+  if (name.length < 2 || name.length > 80) fail(400, 'bad_request', 'اكتب اسم المتجر (حرفان على الأقل).');
+  const placeId = checkPlace(b.placeId);
+  if (S.stores.filter((x) => x.owner_id === user.id).length >= CATALOG_LIMITS.storesPerUser) fail(409, 'store_limit', `لا يمكن إنشاء أكثر من ${CATALOG_LIMITS.storesPerUser} متاجر لحساب واحد`);
+  const t = nowIso();
+  const s: StoreRec = {
+    id: nextId(), public_id: uuid(), owner_id: user.id, realm: user.realm, name_ar: name, description_ar: optText(b.descriptionAr, 500),
+    place_id: placeId, contact_pref: b.contactPref === 'chat_then_phone' ? 'chat_then_phone' : 'chat', hours_ar: optText(b.hoursAr, 120),
+    status: 'active', version: 1, next_position: 1, created_at: t, updated_at: t,
+  };
+  S.stores.push(s);
+  return s;
+}
+
+function updateStore(user: User, s: StoreRec, b: any) {
+  if (b.expectedVersion !== s.version) fail(409, 'version_conflict', 'تغيّر المتجر من مكان آخر. حدّث الصفحة.');
+  if (b.nameAr !== undefined) { const n = String(b.nameAr).trim(); if (n.length < 2 || n.length > 80) fail(400, 'bad_request', 'اكتب اسم المتجر (حرفان على الأقل).'); s.name_ar = n; }
+  const changed: string[] = [];
+  if (b.placeId !== undefined) {
+    const placeId = checkPlace(b.placeId);
+    if (placeId !== s.place_id) {
+      s.place_id = placeId;
+      for (const it of S.items.filter((x) => x.storeId === s.id)) {
+        const row = intentById(it.intentId);
+        if (!row || row.status === 'closed') continue;
+        const spec = intentToSpec(reg, row);
+        spec.place = { ...spec.place, pointPlaceId: placeId };
+        const v = validateSpec(reg, spec);
+        if (!v.ok) continue;
+        updateIntentSpec(row, v.spec, row.title_ar);
+        changed.push(row.id);
+      }
+    }
+  }
+  if (b.descriptionAr !== undefined) s.description_ar = optText(b.descriptionAr, 500);
+  if (b.hoursAr !== undefined) s.hours_ar = optText(b.hoursAr, 120);
+  if (b.contactPref !== undefined) s.contact_pref = b.contactPref === 'chat_then_phone' ? 'chat_then_phone' : 'chat';
+  s.version++; s.updated_at = nowIso();
+  const matching = changed.length ? rematch(changed, 'edit') : null;
+  return { store: storeView(s), matching };
+}
+
+function setStoreStatus(user: User, s: StoreRec, action: string) {
+  if (action !== 'pause' && action !== 'resume') fail(400, 'bad_request', 'إجراء غير صالح');
+  const want = action === 'pause' ? 'paused' : 'active';
+  if (s.status === want) fail(409, 'invalid_transition', action === 'pause' ? 'المتجر موقوف أصلًا' : 'المتجر نشط أصلًا');
+  const changed: string[] = [];
+  for (const it of S.items.filter((x) => x.storeId === s.id)) {
+    const row = intentById(it.intentId);
+    if (!row) continue;
+    if (action === 'pause' ? row.status !== 'active' : !(it.pausedByStore && row.status === 'paused')) continue;
+    if (!setIntentStatus(row, action as 'pause' | 'resume')) continue;
+    changed.push(row.id);
+    if (action === 'pause') it.pausedByStore = true;
+  }
+  if (action === 'resume') for (const it of S.items) if (it.storeId === s.id) it.pausedByStore = false;
+  s.status = want; s.version++; s.updated_at = nowIso();
+  const matching = rematch(changed, 'status');
+  return { store: storeView(s), changed: changed.length, matching };
+}
+
+// ───────────── import ─────────────
+const defaultsOf = (b: any): ImportDefaults => ({
+  currency: CURRENCIES.includes(b.defaultCurrency) ? b.defaultCurrency : null,
+  deal: b.defaultDeal === 'sale' || b.defaultDeal === 'rent' ? b.defaultDeal : null,
+});
+
+function previewImport(s: StoreRec, b: any) {
+  if (typeof b.text !== 'string' || b.text.length > 60_000) fail(400, 'bad_request', 'النص طويل جدًا');
+  const defaults = defaultsOf(b);
+  const lines = splitImportText(b.text);
+  if (!lines.length) fail(422, 'empty_import', 'الصق سطرًا واحدًا على الأقل: اسم المنتج وسعره');
+  if (lines.length > CATALOG_LIMITS.linesPerImport) fail(422, 'too_many_lines', `الحد ${CATALOG_LIMITS.linesPerImport} سطر في المرة الواحدة (لصقت ${lines.length})`);
+  const parsed = lines.map((l) => parseItem(reg, { line: l.text }, { placeId: s.place_id, defaults }, l.lineNo));
+  markDuplicates(parsed, existingNames(s.id));
+  const view = parsed.map((p) => previewLine(reg, p));
+  return {
+    lines: view,
+    summary: { total: view.length, ok: view.filter((l) => l.ok).length, withProblems: view.filter((l) => !l.ok).length, duplicates: view.filter((l) => l.duplicateOf).length },
+    limits: { maxLines: CATALOG_LIMITS.linesPerImport, maxProducts: CATALOG_LIMITS.productsPerStore, remaining: Math.max(0, CATALOG_LIMITS.productsPerStore - liveItemCount(s.id)) },
+    defaults,
+  };
+}
+
+function stable(v: unknown): string {
+  if (Array.isArray(v)) return `[${v.map(stable).join(',')}]`;
+  if (v && typeof v === 'object') return `{${Object.keys(v as object).sort().filter((k) => (v as Record<string, unknown>)[k] !== undefined).map((k) => `${JSON.stringify(k)}:${stable((v as Record<string, unknown>)[k])}`).join(',')}}`;
+  return JSON.stringify(v);
+}
+
+function cleanItems(raw: unknown): ItemInput[] {
+  if (!Array.isArray(raw) || raw.length < 1 || raw.length > CATALOG_LIMITS.linesPerImport) fail(422, raw && Array.isArray(raw) && raw.length ? 'too_many_lines' : 'empty_import', Array.isArray(raw) && raw.length ? `الحد ${CATALOG_LIMITS.linesPerImport} منتج في المرة الواحدة` : 'لا توجد منتجات محددة للحفظ');
+  return (raw as any[]).map((x) => {
+    if (!x || typeof x.line !== 'string' || x.line.length > 400) fail(400, 'bad_request', 'سطر غير صالح');
+    const it: ItemInput = { line: x.line };
+    if (typeof x.nameAr === 'string') it.nameAr = x.nameAr.slice(0, 120);
+    if (typeof x.categoryCode === 'string') it.categoryCode = x.categoryCode.slice(0, 80);
+    if (x.deal === 'sale' || x.deal === 'rent') it.deal = x.deal;
+    if (typeof x.amount === 'string') it.amount = x.amount.slice(0, 24);
+    if (CURRENCIES.includes(x.currency)) it.currency = x.currency;
+    if (UNITS.includes(x.unit)) it.unit = x.unit;
+    if (x.condition === 'new' || x.condition === 'used' || x.condition === null) it.condition = x.condition;
+    if (typeof x.negotiable === 'boolean') it.negotiable = x.negotiable;
+    return it;
+  });
+}
+
+/** Save a previewed list atomically (all or nothing), idempotent by importId — as src/catalog/service.ts confirmImport. */
+export function confirmImport(user: User, s: StoreRec, b: any, opts: { seed?: boolean } = {}) {
+  const importId = String(b.importId ?? '').toLowerCase();
+  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(importId)) fail(400, 'bad_request', 'رقم الإضافة غير صالح');
+  const items = cleanItems(b.items);
+  const defaults = defaultsOf(b);
+  const hash = hash53(stable({ d: defaults, i: items }));
+  const prior = S.imports.find((x) => x.storeId === s.id && x.importId === importId);
+  if (prior) {
+    if (prior.hash !== hash) fail(409, 'import_id_reused', 'رقم هذه الإضافة استُخدم لقائمة مختلفة. أعد المعاينة ثم التأكيد.');
+    return { importId, ...prior.result, replay: true, products: productsByIds(s, prior.result.items.slice(0, 50)), matching: null };
+  }
+  const parsed: ParsedItem[] = items.map((it, k) => parseItem(reg, it, { placeId: s.place_id, defaults }, k + 1));
+  markDuplicates(parsed, existingNames(s.id));
+  const bad = parsed.filter((p) => p.problems.length || !p.spec);
+  if (bad.length) fail(422, 'import_invalid', `في ${bad.length} سطر مشكلة تحتاج تصحيحًا قبل الحفظ`, { lines: bad.map((p) => previewLine(reg, p)) });
+  const live = liveItemCount(s.id);
+  if (live + parsed.length > CATALOG_LIMITS.productsPerStore) fail(422, 'product_limit', `الحد ${CATALOG_LIMITS.productsPerStore} منتج للمتجر (فيه الآن ${live}، والقائمة ${parsed.length})`);
+  const paused = s.status === 'paused';
+  const created: IntentRow[] = [];
+  for (const p of parsed) {
+    const row = createIntent(user.id, s.realm, p.spec as IntentSpec, productTitle(p.nameAr, s.realm), new Date(), p.text);
+    if (paused) setIntentStatus(row, 'pause');
+    S.items.push({ storeId: s.id, intentId: row.id, position: s.next_position++, nameAr: p.nameAr, nameNorm: p.nameNorm, pausedByStore: paused, importId });
+    created.push(row);
+  }
+  s.updated_at = nowIso();
+  const result = { created: created.length, items: created.map((r) => r.public_id), storeStatus: s.status };
+  S.imports.push({ storeId: s.id, importId, hash, result });
+  // 'interactive': the owner is looking at this result now, so only the seekers are notified
+  const matching = s.status === 'active' ? rematch(created.map((r) => r.id), opts.seed ? 'seed' : 'interactive') : null;
+  return { importId, ...result, replay: false, products: productsByIds(s, result.items.slice(0, 50)), matching };
+}
+function productsByIds(s: StoreRec, publicIds: string[]): ProductCard[] {
+  const set = new Set(publicIds);
+  return S.items.filter((it) => it.storeId === s.id && set.has(intentById(it.intentId)?.public_id ?? '')).sort((a, b) => a.position - b.position).map((it) => productCard(s, it));
+}
+
+// ───────────── one product ─────────────
+function editItem(user: User, s: StoreRec, itemId: string, b: any) {
+  const { it, row } = ownItem(user, s, itemId);
+  if (row.status === 'closed') fail(404, 'not_found', 'غير موجود');
+  if (b.expectedVersion !== row.version) fail(409, 'version_conflict', 'تغيّر المنتج من مكان آخر. حدّث الصفحة.');
+  const spec = intentToSpec(reg, row);
+  if (b.amount !== undefined || b.currency !== undefined || b.unit !== undefined || b.negotiable !== undefined) {
+    const cur = spec.price;
+    const minor = b.amount !== undefined ? amountToMinor(String(b.amount)) : cur?.lo ?? cur?.hi ?? null;
+    if (minor === null) fail(422, 'bad_amount', 'السعر المكتوب غير صالح (أرقام فقط، وحتى منزلتين بعد الفاصلة)');
+    const unit = spec.deal === 'sale' ? 'total' : (UNITS.includes(b.unit) ? b.unit : cur?.unit ?? null);
+    if (spec.deal === 'rent' && (!unit || unit === 'total')) fail(422, 'missing_unit', 'الإيجار بالشهر أم باليوم أم بالسنة؟');
+    const currency = CURRENCIES.includes(b.currency) ? b.currency : cur?.currency ?? null;
+    if (!currency) fail(422, 'missing_currency', 'اختر العملة');
+    spec.price = { op: 'eq', lo: minor, hi: minor, currency, unit, strength: 'required', negotiable: typeof b.negotiable === 'boolean' ? b.negotiable : cur?.negotiable ?? false };
+  }
+  if (b.condition !== undefined) { if (b.condition === null) delete spec.attrs.condition; else if (b.condition === 'new' || b.condition === 'used') spec.attrs.condition = b.condition; }
+  const v = validateSpec(reg, spec);
+  if (!v.ok) fail(422, 'invalid_spec', `تعديل غير صالح: ${v.issues.map((i) => i.code).join('، ')}`);
+  let name = it.nameAr;
+  if (b.nameAr !== undefined) {
+    name = String(b.nameAr).replace(/\s+/g, ' ').trim();
+    const norm = normName(name);
+    if (!name || !norm) fail(422, 'bad_name', 'اكتب اسم المنتج');
+    const dup = existingNames(s.id).get(norm);
+    if (dup && dup.id !== itemId) fail(409, 'duplicate', `منتج بنفس الاسم موجود: «${dup.nameAr}»`);
+    it.nameAr = name; it.nameNorm = norm;
+  }
+  updateIntentSpec(row, (v as { ok: true; spec: IntentSpec }).spec, productTitle(name, row.realm));
+  const matching = rematch([row.id], 'edit');
+  return { item: productCard(s, it), matching };
+}
+
+function setItemStatus(user: User, s: StoreRec, itemId: string, action: string) {
+  if (!['pause', 'resume', 'delete'].includes(action)) fail(400, 'bad_request', 'إجراء غير صالح');
+  const { it, row } = ownItem(user, s, itemId);
+  if (action === 'resume' && s.status === 'paused') fail(409, 'store_paused', 'المتجر موقوف. استأنف المتجر أولًا.');
+  if (action === 'delete') {
+    const closed = (row.status === 'active' || row.status === 'paused') && setIntentStatus(row, 'close');
+    S.items = S.items.filter((x) => x !== it);
+    for (const p of S.photos.filter((x) => x.intentId === row.id)) void deletePhotoBlob(p.id);
+    S.photos = S.photos.filter((x) => x.intentId !== row.id);
+    return { item: null, matching: closed ? rematch([row.id], 'status') : emptyRematch() };
+  }
+  if (!setIntentStatus(row, action as 'pause' | 'resume')) fail(409, 'invalid_transition', 'لا يمكن تنفيذ هذا الإجراء على حالة المنتج الحالية');
+  it.pausedByStore = false;
+  const matching = rematch([row.id], 'status');
+  return { item: productCard(s, it), matching };
+}
+
+// ───────────── photos ─────────────
+async function uploadPhoto(user: User, s: StoreRec, itemId: string, body: unknown): Promise<Reply> {
+  const { row } = ownItem(user, s, itemId);
+  if (row.status === 'closed') fail(404, 'not_found', 'غير موجود');
+  if (!(body instanceof Blob)) fail(400, 'empty_upload', 'لم يصل أي ملف');
+  let clean;
+  try { clean = await cleanPhoto(body as Blob); } catch (e) {
+    if (e instanceof MediaRefusal) fail(e.status, e.code, e.message);
+    throw e;
+  }
+  const srcHash = await sha256Hex(clean!.bytes.buffer as ArrayBuffer);
+  const mine = S.photos.filter((p) => p.intentId === row.id);
+  const same = mine.find((p) => p.srcHash === srcHash);
+  const ref = (p: (typeof S.photos)[number]) => ({ id: p.id, url: photoUrl(p.id) ?? '', slot: p.slot, width: p.width, height: p.height, mime: p.mime, bytes: p.bytes });
+  if (same) return new Reply(200, { photo: ref(same), deduplicated: true, alreadyAttached: true, metadataRemoved: [] });
+  if (mine.length >= CATALOG_LIMITS.photosPerProduct) fail(409, 'photo_limit', `الحد ${CATALOG_LIMITS.photosPerProduct} صور للمنتج`);
+  const used = S.photos.reduce((n, p) => n + p.bytes, 0);
+  if (used + clean!.photo.blob.size > BUDGET_BYTES) fail(409, 'demo_storage_full', 'امتلأت مساحة الصور في نسخة المتصفح (٢٥ ميغابايت). احذف بعض الصور أولًا.');
+  const id = uuid();
+  const stored = await putPhoto(id, clean!.photo.blob);
+  const slots = new Set(mine.map((p) => p.slot));
+  let slot = 1;
+  while (slots.has(slot)) slot++;
+  const rec = { id, intentId: row.id, slot, srcHash, mime: clean!.photo.mime, bytes: clean!.photo.blob.size, width: clean!.photo.width, height: clean!.photo.height, createdAt: nowIso(), stored };
+  S.photos.push(rec);
+  // the canvas export carries pixels only: every EXIF/GPS/XMP/IPTC block and comment of the original is gone
+  return new Reply(201, { photo: ref(rec), deduplicated: false, alreadyAttached: false, metadataRemoved: ['all (re-encoded through canvas)'] });
+}
+
+async function removePhoto(user: User, s: StoreRec, itemId: string, photoId: string) {
+  const { row } = ownItem(user, s, itemId);
+  const p = S.photos.find((x) => x.id === photoId && x.intentId === row.id);
+  if (!p) fail(404, 'not_found', 'غير موجود');
+  S.photos = S.photos.filter((x) => x !== p);
+  await deletePhotoBlob(photoId);
+  return { ok: true };
+}
+
+/** Visibility as src/catalog/repo.ts photoForViewer: the owner; others only while product + store are active and they hold a live match. */
+async function photoForViewer(user: User, photoId: string): Promise<Reply> {
+  const p = S.photos.find((x) => x.id === photoId);
+  const row = p ? intentById(p.intentId) : undefined;
+  const it = row ? S.items.find((x) => x.intentId === row.id) : undefined;
+  const s = it ? S.stores.find((x) => x.id === it.storeId) : undefined;
+  if (!p || !row || !s) fail(404, 'not_found', 'غير موجود');
+  if (row!.user_id !== user.id) {
+    const live = row!.status === 'active' && s!.status === 'active' && S.matches.some((m) => m.state !== 'invalidated' && ((m.b === row!.id && m.aUser === user.id) || (m.a === row!.id && m.bUser === user.id)));
+    if (!live) fail(404, 'not_found', 'غير موجود');
+  }
+  const blob = await photoBlob(p!.id);
+  if (!blob) fail(404, 'not_found', 'غير موجود');
+  return new Reply(200, blob, p!.mime);
+}
+
+// ───────────── store info on match cards (src/catalog/match-cards.ts attachStoreInfo) ─────────────
+type CardOut = { state?: string; mine?: { id?: string } | null; other?: { id?: string; status?: string; photos?: PhotoRef[] } | null; store?: unknown; mineStore?: unknown };
+export function attachStoreInfo(cards: CardOut[], viewerId: string): void {
+  for (const c of cards) {
+    const o = c.other?.id ? intentByPublic(c.other.id) : undefined;
+    const oItem = o ? S.items.find((x) => x.intentId === o.id) : undefined;
+    const oStore = oItem ? S.stores.find((x) => x.id === oItem.storeId) : undefined;
+    if (o && oStore && o.user_id !== viewerId) {
+      const synthetic = oStore.realm === 'synthetic';
+      const mine = c.mine?.id ? intentByPublic(c.mine.id) : undefined;
+      const storeIntents = new Set(S.items.filter((x) => x.storeId === oStore.id).map((x) => x.intentId));
+      const n = mine ? S.matches.filter((m) => m.a === mine.id && m.state !== 'invalidated' && storeIntents.has(m.b)).length : 0;
+      c.store = {
+        id: oStore.public_id, nameAr: oStore.name_ar, labelAr: storeLabel(oStore.name_ar, synthetic), synthetic,
+        placeAr: reg.placeById.get(oStore.place_id)?.nameAr ?? null, requestMatches: n, groupLabelAr: groupLabelAr(Math.max(n, 1), oStore.name_ar, synthetic),
+      };
+      const live = (c.state === 'confirmed' || c.state === 'possible') && (c.other?.status === undefined || c.other.status === 'active');
+      if (c.other && oStore.status === 'active' && live) c.other.photos = photoRefs(o.id);
+    }
+    const m = c.mine?.id ? intentByPublic(c.mine.id) : undefined;
+    const mItem = m ? S.items.find((x) => x.intentId === m.id) : undefined;
+    const mStore = mItem ? S.stores.find((x) => x.id === mItem.storeId) : undefined;
+    if (m && mStore && m.user_id === viewerId) c.mineStore = { id: mStore.public_id, nameAr: mStore.name_ar, labelAr: storeLabel(mStore.name_ar, mStore.realm === 'synthetic') };
+  }
+}
+
+// ───────────── routes ─────────────
+const limitsView = () => ({ productsPerStore: CATALOG_LIMITS.productsPerStore, linesPerImport: CATALOG_LIMITS.linesPerImport, photosPerProduct: CATALOG_LIMITS.photosPerProduct, photoBytes: CATALOG_LIMITS.photoBytes });
+
+/** /api/stores/* and /api/photos/:id (null when the path is not a catalog route) */
+export async function catalogRoutes(method: string, p: string, q: URLSearchParams, body: any, user: User): Promise<unknown> {
+  let m: RegExpMatchArray | null;
+  if (method === 'GET' && p === '/api/stores') {
+    return { items: S.stores.filter((x) => x.owner_id === user.id).sort((a, b) => a.created_at.localeCompare(b.created_at) || Number(a.id) - Number(b.id)).map(storeView), limits: { stores: CATALOG_LIMITS.storesPerUser, ...limitsView() } };
+  }
+  if (method === 'POST' && p === '/api/stores') return { store: storeView(createStore(user, body)) };
+  if ((m = p.match(/^\/api\/photos\/([\w-]+)$/)) && method === 'GET') return photoForViewer(user, m[1]!);
+  if (!(m = p.match(/^\/api\/stores\/([\w-]+)(?:\/(.+))?$/))) return null;
+  const s = ownStore(user, m[1]!);
+  const sub = m[2] ?? '';
+  if (sub === '' && method === 'GET') return { store: storeView(s) };
+  if (sub === '' && method === 'PATCH') return updateStore(user, s, body);
+  if (sub === 'status' && method === 'POST') return setStoreStatus(user, s, body.action);
+  if (sub === 'items' && method === 'GET') {
+    const raw = q.get('status');
+    const statuses = !raw || raw === 'all' ? [...ITEM_STATUSES] : [...new Set(raw.split(','))];
+    if (!statuses.every((x) => (ITEM_STATUSES as readonly string[]).includes(x))) fail(400, 'bad_request', 'حالة غير صالحة');
+    const all = S.items.filter((it) => it.storeId === s.id && statuses.includes(intentById(it.intentId)?.status ?? '')).sort((a, b) => a.position - b.position);
+    const pg = offsetPage(all, q);
+    return { ...pg, items: pg.items.map((it) => productCard(s, it)) };
+  }
+  if (sub === 'import/preview' && method === 'POST') return previewImport(s, body);
+  if (sub === 'import/confirm' && method === 'POST') return confirmImport(user, s, body);
+  let mm: RegExpMatchArray | null;
+  if ((mm = sub.match(/^items\/([\w-]+)$/))) {
+    if (method === 'GET') { const { it } = ownItem(user, s, mm[1]!); return { item: productCard(s, it) }; }
+    if (method === 'PATCH') return editItem(user, s, mm[1]!, body);
+  }
+  if ((mm = sub.match(/^items\/([\w-]+)\/status$/)) && method === 'POST') return setItemStatus(user, s, mm[1]!, body.action);
+  if ((mm = sub.match(/^items\/([\w-]+)\/photos$/)) && method === 'POST') return uploadPhoto(user, s, mm[1]!, body);
+  if ((mm = sub.match(/^items\/([\w-]+)\/photos\/([\w-]+)(\/delete)?$/)) && ((method === 'DELETE' && !mm[3]) || (method === 'POST' && mm[3]))) return removePhoto(user, s, mm[1]!, mm[2]!);
+  return fail(404, 'not_found', 'المسار غير موجود في النسخة التجريبية');
+}
+
+// ───────────── demo store seed (src/seed/stores-demo.ts data, same confirm path) ─────────────
+export function seedDemoStores(ensureUser: (handle: string, name: string, persona: string) => User): void {
+  const azaz = reg.placeByCode.get('sy.aleppo.azaz')!;
+  const owner = ensureUser(DEMO_STORE.ownerHandle, DEMO_STORE.ownerName, DEMO_STORE.ownerPersona);
+  const buyer = ensureUser(DEMO_STORE.buyerHandle, DEMO_STORE.buyerName, DEMO_STORE.buyerPersona);
+  // the buyer's request first, so the store's products find it when they are matched (as the server seed)
+  const spec: IntentSpec = {
+    side: 'seek', categoryCode: 'goods.electronics', deal: 'sale',
+    place: { pointPlaceId: null, scopePlaceIds: [azaz.id], scopeStrength: 'required' },
+    price: { op: 'lte', lo: null, hi: '30000', currency: 'USD', unit: 'total', strength: 'required' },
+    when: null, attrs: {}, constraints: [],
+  };
+  const v = validateSpec(reg, spec);
+  if (!v.ok) throw new Error('demo buyer spec invalid');
+  const want = createIntent(buyer.id, 'synthetic', v.spec, 'موبايل للشراء في إعزاز (تجريبي)', new Date(Date.now() - 2 * 3600_000));
+  const store = createStore(owner, { nameAr: DEMO_STORE.storeName, descriptionAr: DEMO_STORE.storeDescription, placeId: azaz.id, contactPref: 'chat', hoursAr: DEMO_STORE.hours });
+  confirmImport(owner, store, { importId: DEMO_STORE.importId, items: DEMO_STORE_LINES.map((line) => ({ line })) }, { seed: true });
+  matchIntent(want.id, 'seed');
+}
