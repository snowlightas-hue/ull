+// Worker job of the share-links feature. Registered in src/worker/main.ts with ONE line:
+//   if (job.kind.startsWith('link_')) return (await import('../links/jobs.ts')).runLinkJob(pool, job);
+//
+// link_sweep (hourly chain, see schedule.ts):
+//   1. live links whose time ran out → ended / expired;
+//   2. every other live link: are ALL of its entries unavailable (graph.ts rule)? → remember since when
+//      (unavailable_since); one available entry again → forget it; all unavailable for 7 days → ended / unavailable,
+//      and the owner gets one notification.
+// Readers do not wait for this: effectiveStatus() applies both rules at read time. The sweep only writes them down
+// (so «روابطي» filters and the counters are cheap) and starts the 7-day clock. Idempotent: every UPDATE re-checks its
+// condition (status = 'live'), and the notification has a per-link dedupe key.
+import type pg from 'pg';
+import type { Job } from '../repo/jobs.ts';
+import { notify } from '../repo/notifications.ts';
+import { availableCount, LINK_COLS, loadGraph, type LinkRow } from './graph.ts';
+import { UNAVAILABLE_MS } from './model.ts';
+import { LINK_SWEEP_KIND, scheduleLinkSweep } from './schedule.ts';
+
+export { LINK_SWEEP_KIND } from './schedule.ts';
+
+export async function runLinkJob(pool: pg.Pool, job: Job): Promise<'done' | 'superseded'> {
+  if (job.kind === LINK_SWEEP_KIND) {
+    await sweepLinks(pool);
+    const more = (await pool.query("SELECT EXISTS (SELECT 1 FROM links WHERE status = 'live') AS more")).rows[0].more;
+    if (more) await scheduleLinkSweep(pool);
+    return 'done';
+  }
+  throw new Error(`unknown job kind ${job.kind}`);
+}
+
+export interface LinkSweepResult { expired: number; markedUnavailable: number; cleared: number; endedUnavailable: number; checked: number }
+
+export async function sweepLinks(pool: pg.Pool, opts: { now?: Date; batch?: number; max?: number } = {}): Promise<LinkSweepResult> {
+  const now = opts.now ?? new Date();
+  const batch = opts.batch ?? 200;
+  const max = opts.max ?? 20_000;
+  const out: LinkSweepResult = { expired: 0, markedUnavailable: 0, cleared: 0, endedUnavailable: 0, checked: 0 };
+
+  // 1. time ran out (ended_at = the moment it expired, not the moment the sweep noticed)
+  for (;;) {
+    const r = await pool.query(
+      `UPDATE links SET status = 'ended', end_reason = 'expired', ended_at = expires_at, version = version + 1, updated_at = $1
+        WHERE id IN (SELECT id FROM links WHERE status = 'live' AND expires_at <= $1 ORDER BY id LIMIT 1000)`, [now]);
+    out.expired += r.rowCount ?? 0;
+    if ((r.rowCount ?? 0) < 1000) break;
+  }
+
+  // 2. all entries unavailable → start / keep / clear the 7-day clock, end after 7 days
+  let after = '0';
+  while (out.checked < max) {
+    const { rows } = await pool.query(`SELECT ${LINK_COLS} FROM links l WHERE l.status = 'live' AND l.id > $1 ORDER BY l.id LIMIT $2`, [after, batch]);
+    if (!rows.length) break;
+    const links: LinkRow[] = rows.map((r) => ({ ...r, id: String(r.id), owner_id: String(r.owner_id) }));
+    after = links[links.length - 1]!.id;
+    out.checked += links.length;
+    const g = await loadGraph(pool, links);
+    for (const l of links) {
+      const c = availableCount(g, l.id, now);
+      const allUnavailable = c.total > 0 && c.available === 0;
+      if (!allUnavailable) {
+        if (l.unavailable_since) {
+          const r = await pool.query("UPDATE links SET unavailable_since = NULL WHERE id = $1 AND status = 'live'", [l.id]);
+          out.cleared += r.rowCount ?? 0;
+        }
+        continue;
+      }
+      if (!l.unavailable_since) {
+        const r = await pool.query("UPDATE links SET unavailable_since = $2 WHERE id = $1 AND status = 'live' AND unavailable_since IS NULL", [l.id, now]);
+        out.markedUnavailable += r.rowCount ?? 0;
+        continue;
+      }
+      if (new Date(l.unavailable_since).getTime() + UNAVAILABLE_MS <= now.getTime()) {
+        const r = await pool.query(
+          `UPDATE links SET status = 'ended', end_reason = 'unavailable', ended_at = $2, version = version + 1, updated_at = $2
+            WHERE id = $1 AND status = 'live' RETURNING owner_id, public_id, title_ar`, [l.id, now]);
+        if (r.rows[0]) {
+          out.endedUnavailable++;
+          await notify(pool, {
+            recipientId: String(r.rows[0].owner_id), kind: 'link_ended', titleAr: 'انتهى رابط مشاركة',
+            bodyAr: `${r.rows[0].title_ar ? `«${r.rows[0].title_ar}» — ` : ''}كل عناصره غير متاحة منذ ٧ أيام، فأُوقف تلقائيًا. يمكنك إنشاء رابط جديد من «روابطي».`,
+            payload: { linkId: r.rows[0].public_id }, dedupeKey: `link-ended:${r.rows[0].public_id}`,
+          }).catch(() => false);
+        }
+      }
+    }
+  }
+  return out;
+}
