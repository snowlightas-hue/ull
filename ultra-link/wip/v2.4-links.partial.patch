@@ -0,0 +1,131 @@
+-- 0007_links.sql — Ultra Link V2.4 "share links" (owner: links role; design: docs/FEATURES-V2.md §3,
+-- details: docs/LINKS.md).
+--
+--  1. links: one shareable, unlisted link. public_id = 13 random base62 characters (77 bits, CHECKed), the only id a
+--     visitor ever sees. realm is the OWNER's realm, copied by a trigger (never from the client): a synthetic owner's
+--     links are synthetic and are labelled «(تجريبي)» on the public page.
+--     kind: intent | product | store | place | collection. Single-item kinds hold exactly one row in link_items; a
+--     collection holds 1..50 ordered rows (enforced by the service; position ≤ 50 by CHECK).
+--     Lifetime: duration 24h | 7d | 30d | until_stopped → expires_at (NULL only for until_stopped, CHECKed).
+--     status live | ended (end_reason stopped | expired | unavailable). Readers treat a live row whose expires_at
+--     passed, or whose items have all been unavailable for 7 days (unavailable_since), as ended at once; the worker's
+--     link_sweep then writes the final status. view_count: a plain counter for the owner — no visitor IP or
+--     identifier is stored anywhere (de-duplication, if any, is an in-memory salted hash, see docs/LINKS.md §5).
+--  2. link_items: the ordered entries of a link. item_no is stable per link (never reused) and is the public "ref" of
+--     an entry; position is the order (UNIQUE DEFERRABLE so a reorder is one UPDATE). Targets by kind:
+--       intent | product → (vertical_id, intent_id)  — FK to intents (a deleted product keeps its closed intent;
+--                                                       the missing store_items row makes it «غير متاح»)
+--       store            → store_id                   — ON DELETE SET NULL (entry stays, shows «غير متاح»)
+--       link             → child_link_id              — ON DELETE SET NULL (same)
+--       place            → place_id (registry) XOR (approx_lat, approx_lng) rounded to 0.01° (~1 km) by the column
+--                          type itself: numeric(4,2)/(5,2) cannot hold a precise GPS fix.
+--     A trigger enforces (a) every target belongs to the link's owner, (b) nesting depth ≤ 2: a child link must not
+--     contain links and a link that is itself inside another link cannot receive links — which also rules out
+--     cycles (a self-reference is refused by a CHECK). The service takes a per-owner advisory lock around structure
+--     changes, so two concurrent edits cannot both pass these checks.
+--
+-- Locks: new tables only (no rewrite of existing tables); milliseconds on the app DB.
+-- Rollback (forward-only runner; inverse statements):
+--   DROP TABLE link_items, links; DROP FUNCTION ul_links_realm(), ul_links_item_check();
+-- Tests: test/integration/links-*.test.ts.
+
+SET LOCAL lock_timeout = '10s';
+
+-- ───────────── 1. links ─────────────
+CREATE TABLE links (
+  id                bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  public_id         text NOT NULL CHECK (public_id ~ '^[0-9A-Za-z]{13}$'),
+  owner_id          bigint NOT NULL REFERENCES users (id) ON DELETE CASCADE,
+  realm             text NOT NULL CHECK (realm IN ('real', 'synthetic')),      -- = users.realm of owner_id (trigger)
+  kind              text NOT NULL CHECK (kind IN ('intent', 'product', 'store', 'place', 'collection')),
+  title_ar          text CHECK (title_ar IS NULL OR char_length(title_ar) BETWEEN 1 AND 80),
+  note_ar           text CHECK (note_ar IS NULL OR char_length(note_ar) BETWEEN 1 AND 500),
+  duration          text NOT NULL CHECK (duration IN ('24h', '7d', '30d', 'until_stopped')),
+  expires_at        timestamptz,
+  status            text NOT NULL DEFAULT 'live' CHECK (status IN ('live', 'ended')),
+  end_reason        text CHECK (end_reason IN ('stopped', 'expired', 'unavailable')),
+  ended_at          timestamptz,
+  unavailable_since timestamptz,                -- every item unavailable since (set/cleared by the sweep)
+  next_item_no      smallint NOT NULL DEFAULT 1 CHECK (next_item_no BETWEEN 1 AND 32000),
+  view_count        bigint NOT NULL DEFAULT 0 CHECK (view_count >= 0),
+  last_viewed_at    timestamptz,
+  version           integer NOT NULL DEFAULT 1 CHECK (version > 0),
+  created_at        timestamptz NOT NULL DEFAULT now(),
+  updated_at        timestamptz NOT NULL DEFAULT now(),
+  CONSTRAINT links_public_id_key UNIQUE (public_id),
+  CONSTRAINT links_expiry_chk CHECK ((duration = 'until_stopped') = (expires_at IS NULL)),
+  CONSTRAINT links_status_chk CHECK (((status = 'live') = (end_reason IS NULL)) AND ((end_reason IS NULL) = (ended_at IS NULL)))
+) WITH (fillfactor = 90);  -- view counter updates stay HOT
+-- «روابطي»: the owner's list, keyset (created_at DESC, id DESC); also the users FK cascade
+CREATE INDEX links_owner_idx ON links (owner_id, created_at DESC, id DESC);
+-- link_sweep walks the live links in id order
+CREATE INDEX links_live_idx ON links (id) WHERE status = 'live';
+
+CREATE FUNCTION ul_links_realm() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  SELECT u.realm INTO NEW.realm FROM users u WHERE u.id = NEW.owner_id;
+  RETURN NEW;
+END $$;
+CREATE TRIGGER links_realm_trg BEFORE INSERT OR UPDATE OF owner_id, realm ON links
+  FOR EACH ROW EXECUTE FUNCTION ul_links_realm();
+
+-- ───────────── 2. link_items ─────────────
+CREATE TABLE link_items (
+  link_id       bigint NOT NULL REFERENCES links (id) ON DELETE CASCADE,
+  item_no       smallint NOT NULL CHECK (item_no > 0),
+  position      smallint NOT NULL CHECK (position BETWEEN 1 AND 50),
+  kind          text NOT NULL CHECK (kind IN ('intent', 'product', 'store', 'place', 'link')),
+  vertical_id   smallint,
+  intent_id     bigint,
+  store_id      bigint REFERENCES stores (id) ON DELETE SET NULL,
+  child_link_id bigint REFERENCES links (id) ON DELETE SET NULL,
+  place_id      integer REFERENCES places (id),
+  approx_lat    numeric(4, 2) CHECK (approx_lat BETWEEN -90 AND 90),
+  approx_lng    numeric(5, 2) CHECK (approx_lng BETWEEN -180 AND 180),
+  desc_ar       text CHECK (desc_ar IS NULL OR char_length(desc_ar) BETWEEN 1 AND 300),
+  created_at    timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY (link_id, item_no),
+  CONSTRAINT link_items_position_key UNIQUE (link_id, position) DEFERRABLE INITIALLY IMMEDIATE,
+  FOREIGN KEY (vertical_id, intent_id) REFERENCES intents (vertical_id, id) ON DELETE CASCADE,
+  CONSTRAINT link_items_target_chk CHECK (CASE kind
+    WHEN 'intent'  THEN vertical_id IS NOT NULL AND intent_id IS NOT NULL AND store_id IS NULL AND child_link_id IS NULL AND place_id IS NULL AND approx_lat IS NULL
+    WHEN 'product' THEN vertical_id IS NOT NULL AND intent_id IS NOT NULL AND store_id IS NULL AND child_link_id IS NULL AND place_id IS NULL AND approx_lat IS NULL
+    WHEN 'store'   THEN vertical_id IS NULL AND intent_id IS NULL AND child_link_id IS NULL AND place_id IS NULL AND approx_lat IS NULL
+    WHEN 'link'    THEN vertical_id IS NULL AND intent_id IS NULL AND store_id IS NULL AND place_id IS NULL AND approx_lat IS NULL
+    WHEN 'place'   THEN vertical_id IS NULL AND intent_id IS NULL AND store_id IS NULL AND child_link_id IS NULL AND ((place_id IS NOT NULL) <> (approx_lat IS NOT NULL))
+  END),
+  CONSTRAINT link_items_point_chk CHECK ((approx_lat IS NULL) = (approx_lng IS NULL)),
+  CONSTRAINT link_items_desc_chk CHECK (desc_ar IS NULL OR kind = 'place'),
+  CONSTRAINT link_items_self_chk CHECK (child_link_id IS NULL OR child_link_id <> link_id)
+);
+-- "is this link inside another link?" (nesting rule) and the SET NULL cascades
+CREATE INDEX link_items_child_idx ON link_items (child_link_id) WHERE child_link_id IS NOT NULL;
+CREATE INDEX link_items_store_idx ON link_items (store_id) WHERE store_id IS NOT NULL;
+CREATE INDEX link_items_intent_idx ON link_items (vertical_id, intent_id) WHERE intent_id IS NOT NULL;
+
+CREATE FUNCTION ul_links_item_check() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE lo bigint; o bigint;
+BEGIN
+  SELECT l.owner_id INTO lo FROM links l WHERE l.id = NEW.link_id;
+  IF NEW.kind IN ('intent', 'product') THEN
+    SELECT i.user_id INTO o FROM intents i WHERE i.vertical_id = NEW.vertical_id AND i.id = NEW.intent_id;
+  ELSIF NEW.kind = 'store' AND NEW.store_id IS NOT NULL THEN
+    SELECT s.owner_id INTO o FROM stores s WHERE s.id = NEW.store_id;
+  ELSIF NEW.kind = 'link' AND NEW.child_link_id IS NOT NULL THEN
+    SELECT c.owner_id INTO o FROM links c WHERE c.id = NEW.child_link_id;
+    IF EXISTS (SELECT 1 FROM link_items x WHERE x.link_id = NEW.child_link_id AND x.kind = 'link') THEN
+      RAISE EXCEPTION 'link_items: link % already contains links (max depth 2)', NEW.child_link_id USING ERRCODE = 'check_violation';
+    END IF;
+    IF EXISTS (SELECT 1 FROM link_items x WHERE x.child_link_id = NEW.link_id) THEN
+      RAISE EXCEPTION 'link_items: link % is inside another link (max depth 2)', NEW.link_id USING ERRCODE = 'check_violation';
+    END IF;
+  ELSE
+    RETURN NEW;  -- place, or a target that was deleted (SET NULL)
+  END IF;
+  IF o IS DISTINCT FROM lo THEN
+    RAISE EXCEPTION 'link_items: the target of link % does not belong to its owner', NEW.link_id USING ERRCODE = 'check_violation';
+  END IF;
+  RETURN NEW;
+END $$;
+CREATE TRIGGER link_items_check_trg BEFORE INSERT OR UPDATE OF link_id, kind, vertical_id, intent_id, store_id, child_link_id ON link_items
+  FOR EACH ROW EXECUTE FUNCTION ul_links_item_check();
