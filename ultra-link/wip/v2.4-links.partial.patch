+// View counter de-duplication for share links (docs/LINKS.md §5). The ONLY thing stored is links.view_count (+ the time
+// of the last view). Nothing about the visitor reaches the database or the logs:
+//   * a view is counted once per (visitor, link) per 30 minutes, decided IN MEMORY by
+//     key = sha256(salt ‖ link id ‖ client address), truncated to 128 bits;
+//   * the salt is 16 random bytes held only in this process and replaced every 24 h; on replacement every key is
+//     forgotten, so an old key can never be linked to a new one and a key cannot be reversed without the salt;
+//   * the map is bounded (oldest dropped first) and lives only in this server process (a restart forgets it; with
+//     several servers a visitor may be counted once per server — accepted, documented);
+//   * the owner's own visits are not counted (the route skips them).
+import { createHash, randomBytes } from 'node:crypto';
+
+export interface ViewCounterOptions { ttlMs?: number; saltMs?: number; maxKeys?: number }
+
+export class ViewCounter {
+  private salt: Buffer = randomBytes(16);
+  private saltAt = -1;
+  private readonly seen = new Map<string, number>();
+  readonly ttlMs: number;
+  readonly saltMs: number;
+  readonly maxKeys: number;
+
+  constructor(opts: ViewCounterOptions = {}) {
+    this.ttlMs = opts.ttlMs ?? 30 * 60_000;
+    this.saltMs = opts.saltMs ?? 24 * 3_600_000;
+    this.maxKeys = opts.maxKeys ?? 100_000;
+  }
+
+  /** true → count this view; false → the same visitor saw this link less than ttlMs ago. */
+  shouldCount(linkId: string, client: string, now: number): boolean {
+    if (this.saltAt < 0 || now - this.saltAt >= this.saltMs || now < this.saltAt) {
+      this.salt = randomBytes(16);
+      this.saltAt = now;
+      this.seen.clear();
+    }
+    const key = createHash('sha256').update(this.salt).update(linkId).update('\u0000').update(client).digest('base64url').slice(0, 22);
+    const last = this.seen.get(key);
+    if (last !== undefined && now - last < this.ttlMs && now >= last) return false;
+    this.seen.delete(key);
+    this.seen.set(key, now);
+    if (this.seen.size > this.maxKeys) {
+      let drop = this.seen.size - Math.floor(this.maxKeys * 0.9);
+      for (const k of this.seen.keys()) { if (drop-- <= 0) break; this.seen.delete(k); }
+    }
+    return true;
+  }
+
+  /** for tests: the in-memory keys (salted hashes only) */
+  keys(): string[] { return [...this.seen.keys()]; }
+  get size(): number { return this.seen.size; }
+}
diff --git a/ultra-link/src/server/routes/links.ts b/ultra-link/src/server/routes/links.ts
new file mode 100644
index 0000000..2d499ba
--- /dev/null
+++ b/ultra-link/src/server/routes/links.ts
@@ -0,0 +1,232 @@
+// Feature routes: share links (V2.4; docs/LINKS.md, contracts in docs/CONTRACTS.md «Share links»). A defineRoutes plugin,
+// so CSRF / auth / rate limits / error format / security headers are inherited.
+//
+// Public (no login; rate-limited per client IP; visitor IPs are kept out of the request log with logLevel 'warn'):
+//   GET  /l/:id                                  → the HTML shell (public/link.html) that loads /js/link-view.js
+//   GET  /api/l/:id                              → {link: PublicLink, viewer: {signedIn, own}}; 404 not_found | link_ended
+//   GET  /api/l/:id/store/:ref?cursor=           → {items, total, nextCursor}  («عرض المزيد» of a store entry)
+//   GET  /api/l/:id/photos/:ref/:slot            → a product photo reachable through this live link (else 404)
+// Signed-in visitor:
+//   POST /api/l/:id/contact          {ref}       → ContactPlan: {action:'contact', matchId, …} | {action:'compose', composeTextAr, …}
+// Owner (404 for anyone else's link):
+//   POST   /api/links                            {kind, target? | items?, titleAr?, noteAr?, duration} → {link}
+//   GET    /api/links?status=live|ended|all&cursor=&dir=&limit= → Page<OwnerLink> (exact total)
+//   GET    /api/links/candidates                 → what can go into a collection (my links, stores, products, intents, places)
+//   GET    /api/links/:id                        → {link: OwnerLink & {items}}
+//   PATCH  /api/links/:id                        {expectedVersion?, titleAr?, noteAr?, duration?} → {link}
+//   POST   /api/links/:id/items                  {expectedVersion?, item} → {link}            (collections)
+//   POST   /api/links/:id/items/:key/delete      {expectedVersion?} → {link}  (also DELETE /api/links/:id/items/:key)
+//   POST   /api/links/:id/order                  {expectedVersion?, items: key[]} → {link}
+//   POST   /api/links/:id/stop                   → {link}   (immediate, final, idempotent)
+//   DELETE /api/links/:id                        → {ok}     (also POST /api/links/:id/delete)
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import type { FastifyReply, FastifyRequest } from 'fastify';
+import { z } from 'zod';
+import { defineRoutes, type RouteRateLimit, type UlRoutePlugin } from '../context.ts';
+import { UUID_RE, validCursor } from '../validate.ts';
+import { ROOT } from '../../lib/env.ts';
+import { MediaStore, defaultMediaDir } from '../../catalog/media-store.ts';
+import { isLinkId, LINK_ID_RE } from '../../links/ids.ts';
+import { DURATION_KEYS, ENDED_AR, LINK_KINDS, NOT_FOUND_AR, parseRef } from '../../links/model.ts';
+import { publicLink, publicStorePage } from '../../links/public.ts';
+import {
+  addItem, candidates, contactPlan, createLink, deleteLink, getLink, LinkError, linkPhoto, listLinks, recordView, removeItem, reorderItems, stopLink, updateLink,
+  type TargetInput,
+} from '../../links/service.ts';
+import { ViewCounter } from '../../links/views.ts';
+
+const UUID = z.string().regex(UUID_RE).transform((s) => s.toLowerCase());
+const LINK_ID = z.string().regex(LINK_ID_RE);
+// lengths in characters are checked by the service (after trimming); these bound the payload
+const optText = (max: number) => z.string().max(max * 4).nullable().optional();
+const Target = z.discriminatedUnion('kind', [
+  z.object({ kind: z.literal('intent'), intentId: UUID }),
+  z.object({ kind: z.literal('product'), itemId: UUID, storeId: UUID.optional() }),
+  z.object({ kind: z.literal('store'), storeId: UUID }),
+  z.object({
+    kind: z.literal('place'),
+    placeId: z.number().int().positive().max(2_000_000_000).nullable().optional(),
+    lat: z.number().min(-90).max(90).nullable().optional(),
+    lng: z.number().min(-180).max(180).nullable().optional(),
+    descAr: optText(300),
+  }),
+  z.object({ kind: z.literal('link'), linkId: LINK_ID }),
+]);
+const Version = z.number().int().positive().max(2_147_483_647).optional();
+const Create = z.object({
+  kind: z.enum(LINK_KINDS),
+  target: Target.optional(),
+  items: z.array(Target).max(60).optional(), // > 50 is refused by the service with a clear 422
+  titleAr: optText(80),
+  noteAr: optText(500),
+  duration: z.enum(DURATION_KEYS),
+});
+const Patch = z.object({ expectedVersion: Version, titleAr: optText(80), noteAr: optText(500), duration: z.enum(DURATION_KEYS).optional() });
+const AddItem = z.object({ expectedVersion: Version, item: Target });
+const Order = z.object({ expectedVersion: Version, items: z.array(z.number().int().min(1).max(32_000)).min(1).max(50) });
+const Contact = z.object({ ref: z.string().max(24) });
+
+const empty = (v: unknown) => (v === '' ? undefined : v);
+const ListQuery = z.object({
+  status: z.preprocess(empty, z.enum(['live', 'ended', 'all']).optional()),
+  cursor: z.preprocess(empty, z.string().optional().refine((c) => c === undefined || validCursor(c, 'ts'), { message: 'bad_cursor' })),
+  dir: z.preprocess(empty, z.enum(['next', 'prev']).optional()),
+  limit: z.preprocess(empty, z.string().regex(/^\d{1,3}$/).transform(Number).pipe(z.number().int().min(1).max(100)).optional()),
+});
+const MoreQuery = z.object({ cursor: z.preprocess(empty, z.string().regex(/^\d{1,9}$/).transform(Number).optional()) });
+
+export interface LinksRoutesOptions {
+  /** injectable clock (tests): expiry, auto-expiry and view de-duplication all read it */
+  now?: () => Date;
+  /** photo directory (default UL_MEDIA_DIR or var/media, the catalog's) */
+  mediaDir?: string;
+  /** public reads per minute per client IP (default 60; env UL_RL_LINK_READ_PER_MIN overrides, 0 = off) */
+  readPerMinute?: number;
+  photoPerMinute?: number;
+  views?: ViewCounter;
+}
+
+export const LINK_RATE_LIMITS = {
+  read: { name: 'link_read', perMinute: 60, by: 'ip' },
+  photo: { name: 'link_photo', perMinute: 300, by: 'ip' },
+  page: { name: 'link_page', perMinute: 120, by: 'ip' },
+  contact: { name: 'link_contact', perMinute: 20 },
+  write: { name: 'link_write', perMinute: 60 },
+} as const satisfies Record<string, RouteRateLimit>;
+
+export function linksRoutes(opts: LinksRoutesOptions = {}): UlRoutePlugin {
+  const clock = opts.now ?? (() => new Date());
+  return defineRoutes('links', async (app, ctx) => {
+    const media = new MediaStore(opts.mediaDir ?? defaultMediaDir());
+    const views = opts.views ?? new ViewCounter();
+    const read: RouteRateLimit = { ...LINK_RATE_LIMITS.read, perMinute: opts.readPerMinute ?? LINK_RATE_LIMITS.read.perMinute };
+    const photo: RouteRateLimit = { ...LINK_RATE_LIMITS.photo, perMinute: opts.photoPerMinute ?? LINK_RATE_LIMITS.photo.perMinute };
+    const write = { rateLimit: LINK_RATE_LIMITS.write };
+    let shell: string | null = null;
+    const shellHtml = () => (shell ??= readFileSync(join(ROOT, 'public', 'link.html'), 'utf8'));
+
+    app.setErrorHandler((err: any, _req, reply) => {
+      if (err instanceof LinkError) return reply.code(err.status).send({ error: err.code, messageAr: err.message });
+      throw err;
+    });
+
+    const me = (req: FastifyRequest) => ctx.user(req);
+    /** owner routes: a malformed id is 400 (like uuidParam), a well-formed id of someone else 404 */
+    const own = (req: FastifyRequest) => {
+      const id = (req.params as { id?: unknown }).id;
+      if (!isLinkId(id)) throw new LinkError(400, 'bad_id', 'معرّف غير صالح');
+      return id;
+    };
+    const unlisted = (reply: FastifyReply) => reply.header('X-Robots-Tag', 'noindex, nofollow, noarchive');
+
+    // ───────────── public page ─────────────
+    app.get<{ Params: { id: string } }>('/l/:id', { logLevel: 'warn', config: { public: true } }, async (req, reply) => {
+      if (!ctx.rateLimit(req, reply, LINK_RATE_LIMITS.page)) return reply;
+      unlisted(reply).header('Cache-Control', 'no-store').type('text/html; charset=utf-8');
+      // no database work here: the page asks /api/l/:id (rate-limited) for the content
+      return reply.code(isLinkId(req.params.id) ? 200 : 404).send(shellHtml());
+    });
+
+    app.get<{ Params: { id: string } }>('/api/l/:id', { logLevel: 'warn', config: { public: true, rateLimit: read } }, async (req, reply) => {
+      unlisted(reply);
+      const id = req.params.id;
+      if (!isLinkId(id)) throw new LinkError(404, 'not_found', NOT_FOUND_AR);
+      const now = clock();
+      const r = await publicLink(ctx.pool, ctx.reg, id, now);
+      if (r.state === 'not_found') throw new LinkError(404, 'not_found', NOT_FOUND_AR);
+      if (r.state === 'ended') throw new LinkError(404, 'link_ended', ENDED_AR);
+      const viewer = ctx.maybeUser(req);
+      const own = viewer?.id === r.row.owner_id;
+      // views: the owner's own visits are not counted; de-duplication is an in-memory salted hash (nothing stored)
+      if (!own && views.shouldCount(r.row.public_id, req.ip, now.getTime())) await recordView(ctx.pool, r.row.id, now);
+      return { link: r.view, viewer: { signedIn: !!viewer, own } };
+    });
+
+    app.get<{ Params: { id: string; ref: string } }>('/api/l/:id/store/:ref', { logLevel: 'warn', config: { public: true, rateLimit: read } }, async (req, reply) => {
+      unlisted(reply);
+      const q = ctx.parseQuery(MoreQuery, req.query);
+      const ref = parseRef(req.params.ref);
+      if (!isLinkId(req.params.id) || !ref || ref.product != null) throw new LinkError(404, 'not_found', 'غير موجود');
+      const page = await publicStorePage(ctx.pool, ctx.reg, req.params.id, ref, q.cursor ?? null, clock());
+      if (page === 'ended') throw new LinkError(404, 'link_ended', ENDED_AR);
+      if (page === 'not_found') throw new LinkError(404, 'not_found', 'غير موجود');
+      return page;
+    });
+
+    app.get<{ Params: { id: string; ref: string; slot: string } }>('/api/l/:id/photos/:ref/:slot', { logLevel: 'warn', config: { public: true, rateLimit: photo } }, async (req, reply) => {
+      const ref = parseRef(req.params.ref);
+      if (!isLinkId(req.params.id) || !ref || !/^[1-6]$/.test(req.params.slot)) throw new LinkError(404, 'not_found', 'غير موجود');
+      const p = await linkPhoto(ctx.pool, req.params.id, ref, Number(req.params.slot), clock());
+      const file = p ? await media.open(p.sha256.toString('hex')) : null;
+      if (!p || !file) throw new LinkError(404, 'not_found', 'غير موجود');
+      return unlisted(reply)
+        .header('Content-Type', p.mime)
+        .header('Content-Length', String(file.size))
+        .header('Content-Disposition', 'inline')
+        .header('X-Content-Type-Options', 'nosniff')
+        .header('Cross-Origin-Resource-Policy', 'same-origin')
+        .send(file.stream);
+    });
+
+    app.post<{ Params: { id: string } }>('/api/l/:id/contact', { logLevel: 'warn', config: { rateLimit: LINK_RATE_LIMITS.contact } }, async (req) => {
+      const { ref } = ctx.body(Contact, req);
+      const r = parseRef(ref);
+      if (!isLinkId(req.params.id)) throw new LinkError(404, 'not_found', NOT_FOUND_AR);
+      if (!r) throw new LinkError(404, 'item_not_found', 'العنصر غير موجود في هذا الرابط');
+      return contactPlan(ctx.pool, ctx.reg, me(req), req.params.id, r, clock());
+    });
+
+    // ───────────── owner ─────────────
+    app.post('/api/links', { config: write }, async (req) => {
+      const b = ctx.body(Create, req);
+      return { link: await createLink(ctx.pool, ctx.reg, me(req), { kind: b.kind, target: b.target as TargetInput | undefined, items: b.items as TargetInput[] | undefined, titleAr: b.titleAr, noteAr: b.noteAr, duration: b.duration }, clock()) };
+    });
+
+    app.get('/api/links', async (req) => {
+      const q = ctx.parseQuery(ListQuery, req.query);
+      return listLinks(ctx.pool, ctx.reg, me(req), { status: q.status ?? 'all', cursor: q.cursor, dir: q.dir === 'prev' ? 'prev' : 'next', limit: q.limit ?? 20 }, clock());
+    });
+
+    app.get('/api/links/candidates', async (req) => candidates(ctx.pool, ctx.reg, me(req), clock()));
+
+    app.get('/api/links/:id', async (req) => ({ link: await getLink(ctx.pool, ctx.reg, me(req), own(req), clock()) }));
+
+    app.patch('/api/links/:id', { config: write }, async (req) => {
+      const id = own(req);
+      const b = ctx.body(Patch, req);
+      return { link: await updateLink(ctx.pool, ctx.reg, me(req), id, { expectedVersion: b.expectedVersion, titleAr: b.titleAr, noteAr: b.noteAr, duration: b.duration }, clock()) };
+    });
+
+    app.post('/api/links/:id/items', { config: write }, async (req) => {
+      const id = own(req);
+      const b = ctx.body(AddItem, req);
+      return { link: await addItem(ctx.pool, ctx.reg, me(req), id, b.item as TargetInput, b.expectedVersion, clock()) };
+    });
+
+    const remove = async (req: FastifyRequest) => {
+      const id = own(req);
+      const key = (req.params as { key: string }).key;
+      if (!/^[1-9]\d{0,4}$/.test(key)) throw new LinkError(400, 'bad_id', 'معرّف غير صالح');
+      const b = ctx.body(z.object({ expectedVersion: Version }), req);
+      return { link: await removeItem(ctx.pool, ctx.reg, me(req), id, Number(key), b.expectedVersion, clock()) };
+    };
+    app.post('/api/links/:id/items/:key/delete', { config: write }, remove);
+    app.delete('/api/links/:id/items/:key', { config: write }, remove);
+
+    app.post('/api/links/:id/order', { config: write }, async (req) => {
+      const id = own(req);
+      const b = ctx.body(Order, req);
+      return { link: await reorderItems(ctx.pool, ctx.reg, me(req), id, b.items, b.expectedVersion, clock()) };
+    });
+
+    app.post('/api/links/:id/stop', { config: write }, async (req) => ({ link: await stopLink(ctx.pool, ctx.reg, me(req), own(req), clock()) }));
+
+    const del = async (req: FastifyRequest) => { await deleteLink(ctx.pool, me(req), own(req)); return { ok: true }; };
+    app.delete('/api/links/:id', { config: write }, del);
+    app.post('/api/links/:id/delete', { config: write }, del);
+  });
+}
+
+/** The plugin to register in src/server/routes/index.ts (FEATURE_ROUTES). */
+export default linksRoutes();
