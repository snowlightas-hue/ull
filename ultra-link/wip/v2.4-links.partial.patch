@@ -0,0 +1,141 @@
+// Share links — constants, shapes and pure helpers (V2.4, docs/LINKS.md). No I/O here: everything is unit-testable.
+import type { Registry } from '../domain/registry.ts';
+import type { DealCode, Side } from '../domain/types.ts';
+import { nearestCity } from '../conversation/engine.ts';
+
+export const LINK_KINDS = ['intent', 'product', 'store', 'place', 'collection'] as const;
+export type LinkKind = (typeof LINK_KINDS)[number];
+export const ITEM_KINDS = ['intent', 'product', 'store', 'place', 'link'] as const;
+export type ItemKind = (typeof ITEM_KINDS)[number];
+
+/** Lifetimes the owner can pick (ms); until_stopped = no expiry. */
+export const DURATIONS = { '24h': 24 * 3_600_000, '7d': 7 * 86_400_000, '30d': 30 * 86_400_000, until_stopped: null } as const;
+export type Duration = keyof typeof DURATIONS;
+export const DURATION_KEYS = ['24h', '7d', '30d', 'until_stopped'] as const satisfies readonly Duration[];
+
+export const LINK_LIMITS = {
+  itemsPerCollection: 50,
+  /** a collection may contain links; those may not contain links (depth ≤ 2) */
+  maxDepth: 2,
+  linksPerOwner: 500,
+  titleChars: 80,
+  noteChars: 500,
+  descChars: 300,
+  /** a link whose items have ALL been unavailable this long ends by itself */
+  unavailableDays: 7,
+  /** products shown per store entry: a store link / a store inside a collection / a «عرض المزيد» page */
+  storePageTop: 24,
+  storePageNested: 6,
+  storePageMore: 24,
+} as const;
+export const UNAVAILABLE_MS = LINK_LIMITS.unavailableDays * 86_400_000;
+
+export const UNAVAILABLE_AR = 'غير متاح';
+export const ENDED_AR = 'انتهى هذا الرابط';
+export const NOT_FOUND_AR = 'هذا الرابط غير موجود. تأكّد أنك نسخته كاملًا.';
+export const DEMO_AR = 'تجريبي';
+
+export function expiresAtFor(duration: Duration, now: Date): Date | null {
+  const ms = DURATIONS[duration];
+  return ms === null ? null : new Date(now.getTime() + ms);
+}
+
+export type EndReason = 'stopped' | 'expired' | 'unavailable';
+export interface LinkTimes { status: 'live' | 'ended'; end_reason: EndReason | null; expires_at: string | Date | null; unavailable_since: string | Date | null; ended_at?: string | Date | null }
+
+/**
+ * The status a visitor sees NOW. A live row whose time ran out, or whose items have all been unavailable for 7 days,
+ * is already ended — the worker's sweep only writes it down later, so the page never depends on the sweep's timing.
+ */
+export function effectiveStatus(l: LinkTimes, now: Date): { live: boolean; reason: EndReason | null } {
+  if (l.status === 'ended') return { live: false, reason: l.end_reason ?? 'stopped' };
+  if (l.expires_at && new Date(l.expires_at).getTime() <= now.getTime()) return { live: false, reason: 'expired' };
+  if (l.unavailable_since && new Date(l.unavailable_since).getTime() + UNAVAILABLE_MS <= now.getTime()) return { live: false, reason: 'unavailable' };
+  return { live: true, reason: null };
+}
+
+/** The same rule in SQL (alias = the links row, now = a timestamptz parameter). */
+export const liveSql = (alias: string, now: string) =>
+  `(${alias}.status = 'live' AND (${alias}.expires_at IS NULL OR ${alias}.expires_at > ${now}) AND (${alias}.unavailable_since IS NULL OR ${alias}.unavailable_since > ${now} - interval '${LINK_LIMITS.unavailableDays} days'))`;
+
+/** Approximate points are stored rounded to 0.01° (≈ 1.1 km of latitude, ≈ 0.9 km of longitude at 36°N). */
+export function roundCoord(v: number): number {
+  return Math.round(v * 100) / 100;
+}
+
+/** «(تجريبي)» on synthetic titles that do not carry it yet. */
+export function demoTitle(t: string, synthetic: boolean): string {
+  return synthetic && !t.includes(DEMO_AR) ? `${t} (${DEMO_AR})` : t;
+}
+
+// ───────────── public refs ─────────────
+// An entry of a link is addressed by its item_no ("3"); an entry of a child link by "3.2"; a product of a store
+// entry by its catalog position ("3-17", "3.2-17"). Refs are positions inside THIS link, never database ids.
+export interface Ref { top: number; child: number | null; product: number | null }
+const REF_RE = /^([1-9]\d{0,4})(?:\.([1-9]\d{0,4}))?(?:-([1-9]\d{0,8}))?$/;
+export function parseRef(s: unknown): Ref | null {
+  if (typeof s !== 'string' || s.length > 24) return null;
+  const m = REF_RE.exec(s);
+  if (!m) return null;
+  return { top: Number(m[1]), child: m[2] ? Number(m[2]) : null, product: m[3] ? Number(m[3]) : null };
+}
+export const refOf = (top: number, child?: number | null, product?: number | null) =>
+  `${top}${child ? `.${child}` : ''}${product ? `-${product}` : ''}`;
+
+// ───────────── places ─────────────
+export interface PlaceView {
+  nameAr: string | null;
+  approx: boolean;
+  /** approximate points only: two decimals at most */
+  lat?: number;
+  lng?: number;
+  nearAr: string | null;
+  descAr: string | null;
+  mapUrl: string | null;
+}
+
+export function placeView(reg: Registry, it: { place_id: number | null; approx_lat: number | string | null; approx_lng: number | string | null; desc_ar: string | null }): PlaceView {
+  if (it.place_id != null) {
+    const p = reg.placeById.get(it.place_id);
+    const parent = p?.parent ? reg.placeByCode.get(p.parent) : undefined;
+    const name = p ? (parent && parent.kind !== 'world' && parent.kind !== 'country' ? `${p.nameAr}، ${parent.nameAr}` : p.nameAr) : null;
+    return { nameAr: name, approx: false, nearAr: null, descAr: it.desc_ar, mapUrl: p ? `https://www.openstreetmap.org/search?query=${encodeURIComponent(p.nameAr)}` : null };
+  }
+  const lat = roundCoord(Number(it.approx_lat));
+  const lng = roundCoord(Number(it.approx_lng));
+  const near = nearestCity(reg, lat, lng);
+  const f = (v: number) => v.toFixed(2);
+  return {
+    nameAr: null, approx: true, lat, lng, nearAr: near != null ? reg.placeById.get(near)?.nameAr ?? null : null, descAr: it.desc_ar,
+    mapUrl: `https://www.openstreetmap.org/?mlat=${f(lat)}&mlon=${f(lng)}#map=13/${f(lat)}/${f(lng)}`,
+  };
+}
+
+export function placeTitle(v: PlaceView): string {
+  if (!v.approx) return v.nameAr ?? 'مكان';
+  return v.nearAr ? `مكان تقريبي قرب ${v.nearAr}` : 'مكان تقريبي';
+}
+
+// ───────────── «احفظ كطلب مشابه» ─────────────
+/**
+ * A sentence for the composer that the app's own understanding turns into the counterpart of a shared item: an offer
+ * → a request («بدي إلكترونيات للشراء في إعزاز»), a request → an offer, an activity → joining it. Built from the
+ * category's name, the deal and the place (never the owner's own wording, which may contain personal details).
+ * The visitor edits it before sending; nothing is saved automatically.
+ */
+export function composeText(reg: Registry, side: Side, categoryCode: string, deal: DealCode, placeId: number | null): string {
+  const cat = reg.categoryByCode.get(categoryCode);
+  const name = cat?.nameAr ?? 'هذا';
+  const place = placeId != null ? reg.placeById.get(placeId) : undefined;
+  const where = place && place.kind !== 'world' ? ` في ${place.nameAr}` : '';
+  if (side === 'provide') return `بدي ${name}${deal === 'sale' ? ' للشراء' : deal === 'rent' ? ' للإيجار' : ''}${where}`;
+  if (side === 'seek') return `عندي ${name}${deal === 'sale' ? ' للبيع' : deal === 'rent' ? ' للإيجار' : ''}${where}`;
+  return `بدي شارك ب${name}${where}`;
+}
+
+export const SIDE_AR: Record<Side, string> = { provide: 'عرض', seek: 'طلب', join: 'نشاط مشترك' };
+
+export function defaultTitle(kind: LinkKind, firstTitle: string | null, itemCount: number): string {
+  if (kind !== 'collection') return firstTitle ?? 'رابط مشاركة';
+  return itemCount === 1 ? 'مجموعة من عنصر واحد' : itemCount === 2 ? 'مجموعة من عنصرين' : itemCount <= 10 ? `مجموعة من ${itemCount} عناصر` : `مجموعة من ${itemCount} عنصرًا`;
+}
