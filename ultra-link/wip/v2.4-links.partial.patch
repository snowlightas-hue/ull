@@ -0,0 +1,69 @@
+// Shared bits for test/integration/links-*.test.ts: an isolated app with the catalog + links plugins (and an injectable
+// clock), and quick ways to make stores, products, intents and links through the real HTTP API.
+import './server-env.ts';
+import assert from 'node:assert/strict';
+import { randomUUID } from 'node:crypto';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { harness, Client, type Harness } from './server-helpers.ts';
+import { closeTolerant } from './catalog-helpers.ts';
+import { catalogRoutes } from '../../src/server/routes/catalog.ts';
+import { linksRoutes, type LinksRoutesOptions } from '../../src/server/routes/links.ts';
+import { ViewCounter } from '../../src/links/views.ts';
+
+export interface LinksEnv {
+  h: Harness;
+  mediaDir: string;
+  clock: { now: Date };
+  views: ViewCounter;
+  close: () => Promise<void>;
+}
+
+/** fresh DB + buildApp with ONLY the catalog and links plugins (as the integrator's index.ts will have them) */
+export async function linksEnv(tag: string, opts: Partial<LinksRoutesOptions> = {}): Promise<LinksEnv> {
+  const mediaDir = mkdtempSync(join(tmpdir(), `ul-links-${tag}-`));
+  const clock = { now: new Date() };
+  const views = new ViewCounter();
+  const h = await harness(`links_${tag}_${process.pid}`, {
+    featureRoutes: false,
+    routes: [catalogRoutes({ mediaDir }), linksRoutes({ now: () => clock.now, mediaDir, views, readPerMinute: 100_000, photoPerMinute: 100_000, ...opts })],
+  });
+  return { h, mediaDir, clock, views, close: async () => { await closeTolerant(h); rmSync(mediaDir, { recursive: true, force: true }); } };
+}
+
+let ipSeq = 10;
+/** a client with its own IP (public reads are rate-limited per IP) */
+export function client(h: Harness): Client { return new Client(h, `198.51.100.${ipSeq++ % 250}`); }
+
+export const placeId = (h: Harness, code: string) => h.db.reg.placeByCode.get(code)!.id;
+
+export async function mkStore(c: Client, h: Harness, name = 'محل الأمل للموبايلات', code = 'sy.aleppo.azaz') {
+  const r = await c.post('/api/stores', { nameAr: name, descriptionAr: 'موبايلات وإكسسوارات', placeId: placeId(h, code), contactPref: 'chat', hoursAr: 'من ٩ للـ ٨' });
+  assert.equal(r.status, 200, r.raw);
+  return r.body.store as { id: string; version: number; synthetic: boolean; labelAr: string };
+}
+
+/** preview → confirm every ok line; returns the products in catalog order */
+export async function importProducts(c: Client, storeId: string, text: string): Promise<{ id: string; nameAr: string; storeId: string; position: number }[]> {
+  const p = await c.post(`/api/stores/${storeId}/import/preview`, { text });
+  assert.equal(p.status, 200, p.raw);
+  const items = p.body.lines.filter((l: any) => l.ok).map((l: any) => l.item);
+  const r = await c.post(`/api/stores/${storeId}/import/confirm`, { importId: randomUUID(), items });
+  assert.equal(r.status, 200, r.raw);
+  return r.body.products;
+}
+
+export async function saved(c: Client, ...texts: string[]): Promise<{ id: string; titleAr: string; side: string }> {
+  const res = await c.dialogue(...texts);
+  assert.equal(res.action, 'saved', JSON.stringify(res).slice(0, 400));
+  return res.intent;
+}
+
+export async function mkLink(c: Client, body: Record<string, unknown>) {
+  const r = await c.post('/api/links', { duration: '7d', ...body });
+  assert.equal(r.status, 200, r.raw);
+  return r.body.link as { id: string; url: string; kind: string; version: number; items: { key: number; ref: string; available: boolean; titleAr: string }[]; [k: string]: any };
+}
+
+export const PHONE_LINES = 'ايفون 12 مستعمل - 300$\nايفون 11 نظيف ٢٥٠ دولار\nايفون 13 برو 500$';
