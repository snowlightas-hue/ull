diff --git a/ultra-link/src/links/graph.ts b/ultra-link/src/links/graph.ts
new file mode 100644
index 0000000..af86e56
--- /dev/null
+++ b/ultra-link/src/links/graph.ts
@@ -0,0 +1,144 @@
+// Loading links with their entries and targets in a few batched queries, and the ONE availability rule that the public
+// page, «روابطي» and the sweep share (docs/LINKS.md §3):
+//   intent  → the intent is active (paused / closed / fulfilled / expired → «غير متاح»); if it is a store product, its
+//             store must also be active
+//   product → the intent is active AND still linked to its store (a deleted product is unlinked) AND the store is active
+//   store   → the store exists, is active and has at least one active product
+//   place   → always available
+//   link    → the child link exists, is live (not stopped / expired) and has at least one available entry
+import type { Queryable } from '../db/pool.ts';
+import { INTENT_COLS, type IntentRow } from '../repo/intents.ts';
+import { effectiveStatus, type EndReason, type ItemKind, type LinkKind } from './model.ts';
+
+export interface LinkRow {
+  id: string; public_id: string; owner_id: string; realm: 'real' | 'synthetic'; kind: LinkKind; title_ar: string | null; note_ar: string | null;
+  duration: '24h' | '7d' | '30d' | 'until_stopped'; expires_at: Date | null; status: 'live' | 'ended'; end_reason: EndReason | null; ended_at: Date | null;
+  unavailable_since: Date | null; next_item_no: number; view_count: string; last_viewed_at: Date | null; version: number;
+  created_at: Date; updated_at: Date; created_key: string;
+}
+export interface ItemRow {
+  link_id: string; item_no: number; position: number; kind: ItemKind; vertical_id: number | null; intent_id: string | null;
+  store_id: string | null; child_link_id: string | null; place_id: number | null; approx_lat: number | null; approx_lng: number | null; desc_ar: string | null;
+}
+export type IntentInfo = IntentRow & {
+  si_store_id: string | null; store_pos: number | null; item_name: string | null; store_status: 'active' | 'paused' | null;
+  store_name: string | null; store_public_id: string | null; store_place_id: number | null;
+};
+export interface StoreInfo {
+  id: string; public_id: string; owner_id: string; realm: 'real' | 'synthetic'; name_ar: string; description_ar: string | null;
+  place_id: number; hours_ar: string | null; status: 'active' | 'paused'; active_count: number;
+}
+
+export const LINK_COLS = `l.id, l.public_id, l.owner_id, l.realm, l.kind, l.title_ar, l.note_ar, l.duration, l.expires_at, l.status, l.end_reason,
+  l.ended_at, l.unavailable_since, l.next_item_no, l.view_count, l.last_viewed_at, l.version, l.created_at, l.updated_at, l.created_at::text AS created_key`;
+export const ITEM_COLS = `li.link_id, li.item_no, li.position, li.kind, li.vertical_id, li.intent_id, li.store_id, li.child_link_id, li.place_id,
+  li.approx_lat::float8 AS approx_lat, li.approx_lng::float8 AS approx_lng, li.desc_ar`;
+export const STORE_COLS = `s.id, s.public_id, s.owner_id, s.realm, s.name_ar, s.description_ar, s.place_id, s.hours_ar, s.status,
+  (SELECT count(*)::int FROM store_items si JOIN intents i ON i.vertical_id = si.vertical_id AND i.id = si.intent_id
+    WHERE si.store_id = s.id AND i.status = 'active') AS active_count`;
+
+const normLink = (r: any): LinkRow => ({ ...r, id: String(r.id), owner_id: String(r.owner_id) });
+const normItem = (r: any): ItemRow => ({ ...r, link_id: String(r.link_id), intent_id: r.intent_id == null ? null : String(r.intent_id), store_id: r.store_id == null ? null : String(r.store_id), child_link_id: r.child_link_id == null ? null : String(r.child_link_id) });
+
+export async function linkByPublicId(db: Queryable, publicId: string, ownerId?: string, lock = ''): Promise<LinkRow | null> {
+  const { rows } = ownerId === undefined
+    ? await db.query({ name: 'ullnk_by_pid', text: `SELECT ${LINK_COLS} FROM links l WHERE l.public_id = $1`, values: [publicId] })
+    : await db.query(`SELECT ${LINK_COLS} FROM links l WHERE l.public_id = $1 AND l.owner_id = $2 ${lock}`, [publicId, ownerId]);
+  return rows[0] ? normLink(rows[0]) : null;
+}
+
+export async function linksByIds(db: Queryable, ids: string[]): Promise<LinkRow[]> {
+  if (!ids.length) return [];
+  const { rows } = await db.query(`SELECT ${LINK_COLS} FROM links l WHERE l.id = ANY($1::bigint[])`, [ids]);
+  return rows.map(normLink);
+}
+
+export async function itemsOf(db: Queryable, linkIds: string[]): Promise<Map<string, ItemRow[]>> {
+  const out = new Map<string, ItemRow[]>(linkIds.map((id) => [id, []]));
+  if (!linkIds.length) return out;
+  const { rows } = await db.query(`SELECT ${ITEM_COLS} FROM link_items li WHERE li.link_id = ANY($1::bigint[]) ORDER BY li.link_id, li.position`, [linkIds]);
+  for (const r of rows.map(normItem)) out.get(r.link_id)!.push(r);
+  return out;
+}
+
+export async function intentsByKeys(db: Queryable, keys: { v: number; id: string }[]): Promise<Map<string, IntentInfo>> {
+  const out = new Map<string, IntentInfo>();
+  if (!keys.length) return out;
+  const { rows } = await db.query(
+    `SELECT ${INTENT_COLS}, si.store_id AS si_store_id, si.position AS store_pos, si.name_ar AS item_name, s.status AS store_status,
+            s.name_ar AS store_name, s.public_id AS store_public_id, s.place_id AS store_place_id
+       FROM unnest($1::smallint[], $2::bigint[]) AS x(v, id)
+       JOIN intents i ON i.vertical_id = x.v AND i.id = x.id
+       LEFT JOIN store_items si ON si.vertical_id = i.vertical_id AND si.intent_id = i.id
+       LEFT JOIN stores s ON s.id = si.store_id`,
+    [keys.map((k) => k.v), keys.map((k) => k.id)]);
+  for (const r of rows) out.set(`${r.vertical_id}:${r.id}`, { ...r, si_store_id: r.si_store_id == null ? null : String(r.si_store_id) });
+  return out;
+}
+
+export async function storesByIds(db: Queryable, ids: string[]): Promise<Map<string, StoreInfo>> {
+  const out = new Map<string, StoreInfo>();
+  if (!ids.length) return out;
+  const { rows } = await db.query(`SELECT ${STORE_COLS} FROM stores s WHERE s.id = ANY($1::bigint[])`, [ids]);
+  for (const r of rows) out.set(String(r.id), { ...r, id: String(r.id), owner_id: String(r.owner_id) });
+  return out;
+}
+
+/** Everything needed to render or judge a set of links: their entries, child links (one level), intents and stores. */
+export interface Graph {
+  links: Map<string, LinkRow>;
+  items: Map<string, ItemRow[]>;
+  intents: Map<string, IntentInfo>;
+  stores: Map<string, StoreInfo>;
+}
+
+export async function loadGraph(db: Queryable, roots: LinkRow[]): Promise<Graph> {
+  const links = new Map(roots.map((l) => [l.id, l]));
+  const items = await itemsOf(db, roots.map((l) => l.id));
+  const childIds = [...new Set([...items.values()].flat().filter((i) => i.kind === 'link' && i.child_link_id).map((i) => i.child_link_id!))].filter((id) => !links.has(id));
+  if (childIds.length) {
+    for (const c of await linksByIds(db, childIds)) links.set(c.id, c);
+    for (const [k, v] of await itemsOf(db, childIds)) items.set(k, v);
+  }
+  const all = [...items.values()].flat();
+  const keys = new Map<string, { v: number; id: string }>();
+  for (const i of all) if (i.intent_id && i.vertical_id != null) keys.set(`${i.vertical_id}:${i.intent_id}`, { v: i.vertical_id, id: i.intent_id });
+  const [intents, stores] = await Promise.all([
+    intentsByKeys(db, [...keys.values()]),
+    storesByIds(db, [...new Set(all.filter((i) => i.store_id).map((i) => i.store_id!))]),
+  ]);
+  return { links, items, intents, stores };
+}
+
+export const intentOf = (g: Graph, it: ItemRow): IntentInfo | undefined => (it.intent_id ? g.intents.get(`${it.vertical_id}:${it.intent_id}`) : undefined);
+
+/** Is this entry available right now? (rule in the header) */
+export function itemAvailable(g: Graph, it: ItemRow, now: Date, depth = 1): boolean {
+  switch (it.kind) {
+    case 'intent': {
+      const i = intentOf(g, it);
+      if (!i || i.status !== 'active') return false;
+      return i.si_store_id == null || i.store_status === 'active';
+    }
+    case 'product': {
+      const i = intentOf(g, it);
+      return !!i && i.status === 'active' && i.si_store_id != null && i.store_status === 'active';
+    }
+    case 'store': {
+      const s = it.store_id ? g.stores.get(it.store_id) : undefined;
+      return !!s && s.status === 'active' && s.active_count > 0;
+    }
+    case 'place':
+      return true;
+    case 'link': {
+      const c = it.child_link_id ? g.links.get(it.child_link_id) : undefined;
+      if (!c || depth >= 2 || !effectiveStatus(c, now).live) return false;
+      return (g.items.get(c.id) ?? []).some((x) => itemAvailable(g, x, now, depth + 1));
+    }
+  }
+}
+
+export function availableCount(g: Graph, linkId: string, now: Date): { total: number; available: number } {
+  const list = g.items.get(linkId) ?? [];
+  return { total: list.length, available: list.filter((x) => itemAvailable(g, x, now)).length };
+}
diff --git a/ultra-link/src/links/ids.ts b/ultra-link/src/links/ids.ts
