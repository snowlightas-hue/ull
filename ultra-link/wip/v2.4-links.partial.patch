index 0000000..1f5035e
--- /dev/null
+++ b/ultra-link/src/links/ids.ts
@@ -0,0 +1,24 @@
+// Share-link ids (V2.4, docs/LINKS.md §4). 13 characters of base62 from the OS CSPRNG: 13 × log2(62) ≈ 77.4 bits.
+// (12 base62 characters would be 71.4 bits — just under the 72-bit floor — hence 13.) Alphanumeric only, so chat apps'
+// auto-linkers never cut a trailing "-" or "_". Rejection sampling (bytes ≥ 248 are dropped) keeps every character
+// uniformly distributed: 248 = 4 × 62.
+import { randomBytes } from 'node:crypto';
+
+export const LINK_ID_LEN = 13;
+export const LINK_ID_RE = /^[0-9A-Za-z]{13}$/;
+export const LINK_ID_BITS = LINK_ID_LEN * Math.log2(62);
+const ALPHABET = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
+
+export function newLinkId(rand: (n: number) => Uint8Array = randomBytes): string {
+  let out = '';
+  while (out.length < LINK_ID_LEN) {
+    for (const b of rand(24)) {
+      if (b >= 248) continue;
+      out += ALPHABET[b % 62];
+      if (out.length === LINK_ID_LEN) break;
+    }
+  }
+  return out;
+}
+
+export const isLinkId = (v: unknown): v is string => typeof v === 'string' && LINK_ID_RE.test(v);
